---
// The page menu, on the row above the title: "Copy page" (the page as Markdown, one click) and a
// panel of the rest — copy the link, view the Markdown, open the page in an assistant, download the
// PDF, print.
//
// Everything that is a link is a real link, rendered here, and works without JavaScript; the two
// things that need script (copy, print) are `hidden` until <sggs-page-actions> upgrades
// (src/widgets/page-actions.ts). A disclosure (<details>), not an ARIA menu: most items are links.
// Marked data-pagefind-ignore: <main> is the search index, and this is chrome.
import { exportedIds, SITE_ORIGIN } from '../../plugins/export-pages.mjs';
import { assistantLinks } from '../../plugins/assistant-links.mjs';
import { PDFS } from '../../plugins/features.mjs';

const route = Astro.locals.starlightRoute;
const id = route.id || 'index';
const hasMarkdown = exportedIds().has(id);
const isReference = id === 'api/reference' || id.startsWith('api/reference/');
const show = id !== '404' && (hasMarkdown || isReference);
const pageUrl = SITE_ORIGIN + (id === 'index' ? '/' : `/${id}/`);
const markdown = hasMarkdown ? `/md/${id}.md` : null;
// an assistant reads the published Markdown; the generated API reference has none, so it reads the page
const ask = show ? assistantLinks({ url: markdown ? SITE_ORIGIN + markdown : pageUrl, title: route.entry.data.title }) : null;
// the pre-built PDF (scripts/build-pdfs.mjs): every exported page has one when the build made them
const updated = route.lastUpdated ? route.lastUpdated.toISOString().slice(0, 10) : null;
const pdf = PDFS && markdown ? { href: `/pdf/${id}.pdf`, name: `sggs-kb_${id.replace(/\//g, '-')}${updated ? `_${updated}` : ''}.pdf` } : null;
const primary = markdown ? { action: 'copy-md', label: 'Copy page' } : { action: 'copy-link', label: 'Copy link' };
---
{show && ask && (
  <sggs-page-actions class="pa" data-pagefind-ignore="" data-md={markdown} data-production={new URL(SITE_ORIGIN).hostname}>
    <div class="pa__split">
      <button type="button" class="pa__btn pa__primary" data-action={primary.action} data-label={primary.label} hidden>
        <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" /></svg>
        <span class="pa__label">{primary.label}</span>
      </button>
      <details class="pa__more">
        <summary class="pa__btn pa__toggle">
          <span class="pa__toggle-label">Page actions</span>
          <svg class="pa__icon pa__chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" /></svg>
        </summary>
        <div class="pa__panel">
          <ul class="pa__group" aria-label="Copy">
            {markdown && (
              <li><button type="button" class="pa__item" data-action="copy-md" data-label="Copy page as Markdown" hidden>
                <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" /></svg>
                <span class="pa__label">Copy page as Markdown</span>
              </button></li>
            )}
            <li><button type="button" class="pa__item" data-action="copy-link" data-label="Copy link" hidden>
              <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6.5 9.5a3 3 0 0 0 4.2 0l2-2a3 3 0 0 0-4.2-4.2l-.7.7" /><path d="M9.5 6.5a3 3 0 0 0-4.2 0l-2 2a3 3 0 0 0 4.2 4.2l.7-.7" /></svg>
              <span class="pa__label">Copy link</span>
            </button></li>
          </ul>
          <ul class="pa__group" aria-label="Open">
            {markdown && (
              <li><a class="pa__item" href={markdown} target="_blank" rel="noopener">
                <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M9 2.5H4.5A1.5 1.5 0 0 0 3 4v8a1.5 1.5 0 0 0 1.5 1.5h7A1.5 1.5 0 0 0 13 12V6.5z" /><path d="M9 2.5v4h4M5.5 9h5M5.5 11h3" /></svg>
                <span class="pa__label">View as Markdown</span><span class="sr-only"> (opens in a new tab)</span>
              </a></li>
            )}
            {isReference && (
              <li><a class="pa__item" href="https://github.com/Algorythmos-AI/sggs-platform/blob/integration/contract/openapi.json" target="_blank" rel="noopener noreferrer">
                <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M9 2.5H4.5A1.5 1.5 0 0 0 3 4v8a1.5 1.5 0 0 0 1.5 1.5h7A1.5 1.5 0 0 0 13 12V6.5z" /><path d="M9 2.5v4h4" /></svg>
                <span class="pa__label">Open OpenAPI JSON</span><svg class="pa__icon pa__out" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 4h6v6M12 4 4.5 11.5" /></svg><span class="sr-only"> (opens in a new tab)</span>
              </a></li>
            )}
            <li><a class="pa__item" href={ask.chatgpt} target="_blank" rel="noopener noreferrer">
              <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 4.5A1.5 1.5 0 0 1 4.5 3h7A1.5 1.5 0 0 1 13 4.5v5a1.5 1.5 0 0 1-1.5 1.5H8l-3 2.5V11h-.5A1.5 1.5 0 0 1 3 9.5z" /></svg>
              <span class="pa__label">Ask ChatGPT</span><svg class="pa__icon pa__out" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 4h6v6M12 4 4.5 11.5" /></svg><span class="sr-only"> (opens in a new tab)</span>
            </a></li>
            <li><a class="pa__item" href={ask.claude} target="_blank" rel="noopener noreferrer">
              <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 4.5A1.5 1.5 0 0 1 4.5 3h7A1.5 1.5 0 0 1 13 4.5v5a1.5 1.5 0 0 1-1.5 1.5H8l-3 2.5V11h-.5A1.5 1.5 0 0 1 3 9.5z" /></svg>
              <span class="pa__label">Ask Claude</span><svg class="pa__icon pa__out" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 4h6v6M12 4 4.5 11.5" /></svg><span class="sr-only"> (opens in a new tab)</span>
            </a></li>
          </ul>
          <p class="pa__note">ChatGPT and Claude are third-party services. The link gives them this page's public address and a short instruction. This site records nothing.</p>
          <p class="pa__note pa__note--preview" hidden>Preview: the published page may be older or missing.</p>
          <ul class="pa__group pa__group--export" aria-label="Export" hidden={!pdf}>
            {pdf && (
              <li><a class="pa__item" href={pdf.href} download={pdf.name}>
                <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2.5v8M4.5 7.5 8 11l3.5-3.5M3 13.5h10" /></svg>
                <span class="pa__label">Download PDF</span>
              </a></li>
            )}
            <li><button type="button" class="pa__item" data-action="print" data-label="Print" hidden>
              <svg class="pa__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 6V2.5h7V6M4.5 11.5h-1A1.5 1.5 0 0 1 2 10V7.5A1.5 1.5 0 0 1 3.5 6h9A1.5 1.5 0 0 1 14 7.5V10a1.5 1.5 0 0 1-1.5 1.5h-1" /><rect x="4.5" y="9.5" width="7" height="4" /></svg>
              <span class="pa__label">Print</span>
            </button></li>
          </ul>
        </div>
      </details>
    </div>
    <p class="pa__status" role="status" aria-live="polite"></p>
  </sggs-page-actions>
)}
