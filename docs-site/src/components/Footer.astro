---
// Starlight's footer (edit link, pagination) plus the site's own: where the product lives, what
// changed, the source, and how to report a problem. The page's date and verified stamp are under
// its title (src/components/PageTitle.astro). On paper, a colophon closes the page.
import Default from '@astrojs/starlight/components/Footer.astro';
import { SITE_ORIGIN } from '../../plugins/export-pages.mjs';
const repo = 'https://github.com/Algorythmos-AI/sggs-platform';
// On paper the page ends with where it came from (src/styles/print.css shows it; hidden on screen).
const route = Astro.locals.starlightRoute;
const pageId = route.id || 'index';
const pageUrl = SITE_ORIGIN + (pageId === 'index' ? '/' : `/${pageId}/`);
const commit = (process.env.PUBLIC_DOCS_COMMIT ?? '').slice(0, 7);
const verified = (route.entry.data as { verified?: { commit: string; date: string } }).verified;
const updated = route.lastUpdated;
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Default><slot /></Default>
{pageId !== '404' && (
  <p class="print-only print-colophon" data-pagefind-ignore>
    Sri Guru Granth Sahib Ji — Knowledge Base wiki.
    {/^[0-9a-f]{7}$/.test(commit) && <span> Generated from commit {commit}.</span>}
    {updated && <span> Updated {day(updated)}.</span>}
    {verified && <span> Verified against {verified.commit.slice(0, 7)} on {verified.date}.</span>}
    <span class="print-colophon__printed"></span>
    <span> This copy may be out of date; the page is at {pageUrl}</span>
  </p>
)}
<nav class="site-footer" aria-label="Site">
  <p class="site-footer__links">
    <a href="https://gurbanisoul.com/">gurbanisoul.com</a>
    <a href="/reference/releases/">What changed</a>
    <a href="/api/">The API</a>
    <a href={repo}>Source on GitHub</a>
    <a href={`${repo}/issues/new?labels=documentation`}>Report a problem</a>
  </p>
  <p class="site-footer__note">
    Sri Guru Granth Sahib Ji is quoted verbatim, cited by Ang, and never altered. Built by Algorythmos.
  </p>
</nav>

<style>
  .site-footer { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--sl-color-hairline); font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .site-footer__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0; }
  .site-footer__links a { color: var(--sl-color-gray-2); text-decoration: none; }
  .site-footer__links a:hover { color: var(--sl-color-white); text-decoration: underline; }
  .site-footer__note { margin: 0.75rem 0 0; }
</style>
