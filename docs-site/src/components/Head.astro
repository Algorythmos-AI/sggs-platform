---
// Starlight's <head> plus: a link to the page as Markdown, the page's Open Graph card (prerendered by src/pages/og/[...id].png.ts for
// every collection page; the generated API reference and the 404 page fall back to the landing card)
// and the widget bundle (one script, loaded once per page, deferred by Astro). Starlight already emits
// twitter:card; this adds the image (with its size, type and alt), the theme colours and the home-screen icon.
import Default from '@astrojs/starlight/components/Head.astro';
import { getEntry } from 'astro:content';
import { exportedIds } from '../../plugins/export-pages.mjs';
const { id } = Astro.locals.starlightRoute;
const pageId = id || 'index';
const entry = (await getEntry('docs', pageId)) ?? (await getEntry('docs', 'index'));
const ogId = entry!.id;
const site = (Astro.site ?? new URL('https://docs.gurbanisoul.com')).origin;
const ogImage = `${site}/og/v2/${ogId}.png`;
const ogAlt = `${entry!.data.title} · engineering wiki, docs.gurbanisoul.com (Gurbani Soul)`;
// the page as Markdown (src/pages/md/); the 404 page and the generated API reference have none
const markdown = exportedIds().has(pageId) ? `/md/${pageId}.md` : null;
---
<Default><slot /></Default>
{markdown && <link rel="alternate" type="text/markdown" href={markdown} title="This page as Markdown" />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
<!-- the browser chrome takes the page's colour in each theme; the home-screen icon is the product's -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#FBF7F0" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171412" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<!-- every title is set in it: fetched with the page, so the title is rarely drawn in a fallback first -->
<link rel="preload" href="/fonts/SourceSerif4-latin.woff2" as="font" type="font/woff2" crossorigin />
<script>
  import '../widgets/index.ts';
</script>
