---
// Base.astro — the Knowledge Base shell: head, the top bar (the cloth: mark, the five places,
// the saroop and theme buttons), a second row for a place with several pages, the phone tab bar,
// the footer, the shared composition modal (#panel) + toast, the saved-verses drawer, and the
// global scripts. A page gets its own <h1> from its title unless it passes `heading`.
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { normPath } from '../routes';
import kbThemes from '../generated/kb-themes.json';
export interface Props { title?: string; description?: string; heading?: string | false; }
const {
  title = 'ੴ Sri Guru Granth Sahib Ji — Knowledge Base',
  description = 'Study Sri Guru Granth Sahib Ji online: all 1430 Angs in verbatim Gurmukhi, cited by Ang, searchable by word, sound, first letters and theme.',
  heading,
} = Astro.props;
// Canonical/OG derive from the page's own route (KB pages resolve to the knowledge-base OG card).
const path = normPath(Astro.url.pathname);
// The colour themes a stored choice may name (generated from docs/brand/web-themes.json); the
// default theme needs no attribute.
const ACCENTS = kbThemes.themes.map((t) => t.id).filter((id) => id !== kbThemes.default);

// The five places, the same on every screen: a row in the top bar on a wide screen, a tab bar on a
// phone. A place with several pages lists them in a second row under the bar. (Saved is the fifth:
// it opens the drawer, so it is a button.)
const PLACES = [
  { id: 'home', label: 'Home', href: '/library', paths: ['/library'],
    icon: 'M4 11l8-7 8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z' },
  { id: 'read', label: 'Read', href: '/reader', paths: ['/reader', '/nitnem', '/browse'],
    icon: 'M5 5h9a3 3 0 0 1 3 3v12H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h9',
    pages: [{ href: '/reader', label: 'Reader' }, { href: '/nitnem', label: 'Nitnem' }, { href: '/browse', label: 'Index' }] },
  { id: 'search', label: 'Search', href: '/search', paths: ['/search'],
    icon: 'M5 11a6 6 0 1 0 12 0a6 6 0 1 0-12 0zM20 20l-4.5-4.5' },
  { id: 'explore', label: 'Explore', href: '/themes',
    paths: ['/themes', '/constellation', '/trail', '/lineage', '/analytics', '/raag-clock', '/divergence'],
    icon: 'M3.5 12a8.5 8.5 0 1 0 17 0a8.5 8.5 0 1 0-17 0zM15 9l-1.8 4.2L9 15l1.8-4.2z',
    pages: [{ href: '/themes', label: 'Themes' }, { href: '/constellation', label: 'Constellation' },
            { href: '/trail', label: 'Verse trail' }, { href: '/lineage', label: 'Contributors' },
            { href: '/analytics', label: 'Insights' }, { href: '/raag-clock', label: 'Raag Clock' }] },
];
const SAVED_ICON = 'M7 4h10v16l-5-4-5 4z';
const place = PLACES.find((p) => p.paths.includes(path));
const subnav = place?.pages;
// aria-current: "page" on the link to this very page, "true" on the place it belongs to
const here = (href: string) => (href === path ? 'page' : 'true');
const subCurrent = (href: string) =>
  href === path ? 'page' : (path === '/divergence' && href === '/raag-clock' ? 'true' : undefined);
// the page's own heading: what follows the site name in its <title>, unless the page supplies one
const pageName = heading === false ? '' : (heading ?? title.replace(/^ੴ\s*Sri Guru Granth Sahib Ji\s*—\s*/, ''));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes, viewport-fit=cover" />
  <title>{title}</title>
  <Seo title={title} description={description} path={path} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Resolve the theme, the colour theme and the paper tone before first paint (no flash).
       Inline + un-bundled on purpose. A stored value is used only if it is one we know; with
       storage blocked, the stylesheet's defaults apply. -->
  <script is:inline define:vars={{ ACCENTS }}>
    (function () {
      var root = document.documentElement;
      try {
        var t = localStorage.getItem('theme') || 'system';
        var d = t === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        root.setAttribute('data-theme', d);
        var a = localStorage.getItem('sggs_accent');
        if (ACCENTS.indexOf(a) !== -1) root.setAttribute('data-accent', a);
        if (localStorage.getItem('sggs_reader_tone') === 'warm') root.setAttribute('data-tone', 'warm');
      } catch (e) {}
    })();
  </script>
  <!-- Preload the bundled Gurmukhi scripture font for a fast swap (display layer only). -->
  <link rel="preload" href="/fonts/SantLipi-VF.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body class:list={[Astro.slots.has('hero') && 'has-hero']}>
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="kb-chrome" data-topbar>
    <header class="kb-top">
      <a class="kb-brand" href="/library" aria-label="Knowledge Base home">
        <span class="kb-mark gm" lang="pa" aria-hidden="true">ੴ</span><span class="kb-word">Knowledge Base</span>
      </a>
      <span class="kb-here" aria-hidden="true">{pageName || 'Knowledge Base'}</span>
      <nav class="kb-places" aria-label="Places">
        {PLACES.map((p) => (
          <a href={p.href} data-place={p.id} class:list={[place?.id === p.id && 'on']}
             aria-current={place?.id === p.id ? here(p.href) : undefined}>{p.label}</a>
        ))}
        <button type="button" data-open-saved>Saved<span class="kb-count" data-saved-count hidden>0</span></button>
      </nav>
      <span class="kb-grow"></span>
      <button id="randomBtn" type="button">✦ Hukam-style random</button>
      <button id="saroopBtn" class="kb-ibtn gm" type="button" lang="pa" aria-pressed="false" aria-label="Toggle traditional Gurmukhi rendering (display only — does not change the scripture text)" title="Traditional saroop (display only)">ਯ</button>
      <button id="themeBtn" class="kb-ibtn" type="button" aria-label="Theme" title="Theme">◐</button>
    </header>
    {subnav && (
      <nav class="kb-sub" aria-label={`${place.label}: pages`}>
        {subnav.map((pg) => (
          <a href={pg.href} data-path={pg.href} class:list={[subCurrent(pg.href) && 'on']} aria-current={subCurrent(pg.href)}>{pg.label}</a>
        ))}
      </nav>
    )}
  </div>
  <slot name="hero" />
  <main id="main">
    {pageName && <h1 class="page-title">{pageName}</h1>}
    <slot />
  </main>
  <footer class="kb-foot">Scripture is shown verbatim from your edition with its Ang. Transliteration is a mechanical reading aid, not the scripture. · <span class="gm" lang="pa">ਧੁਰ ਕੀ ਬਾਣੀ</span><span id="ver"></span> · <a href="/">Gurbani Soul app</a> · <a href="/support">Support</a> · <a href="/privacy">Privacy</a></footer>
  <nav class="kb-tabs" aria-label="Places">
    {PLACES.map((p) => (
      <a href={p.href} data-place={p.id} class:list={[place?.id === p.id && 'on']}
         aria-current={place?.id === p.id ? here(p.href) : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={p.icon} /></svg>{p.label}
      </a>
    ))}
    <button type="button" data-open-saved>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={SAVED_ICON} /></svg>Saved<span class="kb-count" data-saved-count hidden>0</span>
    </button>
  </nav>

  <div id="toast" role="status"></div>
  <div class="panel" id="panel" role="dialog" aria-modal="true" aria-labelledby="ptitle">
    <div class="inner">
      <button class="x" onclick="closePanel()" aria-label="Close">×</button>
      <h3 id="ptitle"></h3>
      <div id="pbody"></div>
    </div>
  </div>
  <!-- Saved verses: the pins kept in this browser, and what connects them (every page) -->
  <div id="trailScrim" class="trail-scrim" aria-hidden="true"></div>
  <aside id="trailDrawer" class="trail-drawer" role="dialog" aria-modal="true" aria-label="Saved verses" inert>
    <div class="trail-dhead">
      <div class="trail-dtitle">Saved</div>
      <button id="trailClose" class="trail-close" type="button" aria-label="Close saved verses">×</button>
    </div>
    <div id="trailTabs" class="trail-tabs" role="tablist" aria-label="Saved verses: views">
      <button data-tab="pinned" class="on" role="tab" aria-selected="true" type="button">Pinned Verses</button>
      <button data-tab="insights" role="tab" aria-selected="false" type="button">Connections</button>
    </div>
    <div class="trail-dbody">
      <div id="tab-pinned" role="tabpanel"></div>
      <div id="tab-insights" role="tabpanel" style="display:none"></div>
    </div>
  </aside>

  <script>
    import '../scripts/core';
    import '../scripts/panel';
    import '../scripts/studytrail';
    import '../scripts/saroop';
  </script>
</body>
</html>
