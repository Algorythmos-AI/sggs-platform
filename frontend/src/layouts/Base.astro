---
// Base.astro — the shared MPA shell: head, header (with theme toggle), nav, footer,
// the shared composition modal (#panel) + toast, and the global core/panel scripts.
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { normPath } from '../routes';
import kbThemes from '../generated/kb-themes.json';
export interface Props { title?: string; description?: string; }
const {
  title = 'ੴ Sri Guru Granth Sahib Ji — Knowledge Base',
  description = 'Study Sri Guru Granth Sahib Ji online: all 1430 Angs in verbatim Gurmukhi, cited by Ang, searchable by word, sound, first letters and theme.',
} = Astro.props;
// Canonical/OG derive from the page's own route (KB pages resolve to the knowledge-base OG card).
const path = normPath(Astro.url.pathname);
// The colour themes a stored choice may name (generated from docs/brand/web-themes.json); the
// default theme needs no attribute.
const ACCENTS = kbThemes.themes.map((t) => t.id).filter((id) => id !== kbThemes.default);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes" />
  <title>{title}</title>
  <Seo title={title} description={description} path={path} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Resolve the theme, the colour theme and the paper tone before first paint (no flash).
       Inline + un-bundled on purpose. A stored value is used only if it is one we know; with
       storage blocked, the stylesheet's defaults apply. -->
  <script is:inline define:vars={{ ACCENTS }}>
    (function () {
      var root = document.documentElement;
      try {
        var t = localStorage.getItem('theme') || 'system';
        var d = t === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        root.setAttribute('data-theme', d);
        var a = localStorage.getItem('sggs_accent');
        if (ACCENTS.indexOf(a) !== -1) root.setAttribute('data-accent', a);
        if (localStorage.getItem('sggs_reader_tone') === 'warm') root.setAttribute('data-tone', 'warm');
      } catch (e) {}
    })();
  </script>
  <!-- Preload the bundled Gurmukhi scripture font for a fast swap (display layer only). -->
  <link rel="preload" href="/fonts/SantLipi-VF.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site" lang="en">
    <div class="glow" aria-hidden="true"></div>
    <div class="onkar gm" aria-hidden="true">ੴ</div>
    <h1>Sri Guru Granth Sahib Ji — Knowledge Base</h1>
    <p>1430 Angs · verbatim Gurmukhi · searchable by word, sound, first letters &amp; theme</p>
    <button id="saroopBtn" class="themebtn gm" type="button" lang="pa" aria-pressed="false" aria-label="Toggle traditional Gurmukhi rendering (display only — does not change the scripture text)" title="Traditional saroop (display only)">ਯ</button>
    <button id="themeBtn" class="themebtn" type="button" aria-label="Theme" title="Theme">◐</button>
  </header>
  <nav class="site">
    <a href="/" data-path="/">Home</a>
    <a href="/search" data-path="/search">Search</a>
    <a href="/reader" data-path="/reader">Reader</a>
    <a href="/nitnem" data-path="/nitnem">Nitnem</a>
    <a href="/browse" data-path="/browse">Index</a>
    <a href="/themes" data-path="/themes">Themes</a>
    <a href="/lineage" data-path="/lineage">Lineage</a>
    <a href="/trail" data-path="/trail">Trail</a>
    <a href="/analytics" data-path="/analytics">Insights</a>
    <a href="/constellation" data-path="/constellation">Constellation</a>
    <a href="/raag-clock" data-path="/raag-clock">Raag Clock</a>
    <button id="randomBtn" type="button">✦ Hukam-style random</button>
  </nav>
  <main id="main">
    <slot />
  </main>

  <div id="toast" role="status"></div>
  <div class="panel" id="panel" role="dialog" aria-modal="true" aria-labelledby="ptitle">
    <div class="inner">
      <button class="x" onclick="closePanel()" aria-label="Close">×</button>
      <h3 id="ptitle"></h3>
      <div id="pbody"></div>
    </div>
  </div>
  <footer class="site">Scripture is shown verbatim from your edition with its Ang. Transliteration is a mechanical reading aid, not the scripture. · <span class="gm">ਧੁਰ ਕੀ ਬਾਣੀ</span><span id="ver"></span> · <a href="/support">Support</a> · <a href="/privacy">Privacy</a></footer>

  <!-- Study Trail: a persistent, ML-aware cross-reference collection (every page) -->
  <button id="trailFab" class="trail-fab" type="button" aria-label="Open study trail">
    <span class="trail-fab-i" aria-hidden="true">📌</span><span id="trailFabN" class="trail-fab-n">0</span>
  </button>
  <div id="trailScrim" class="trail-scrim" aria-hidden="true"></div>
  <aside id="trailDrawer" class="trail-drawer" role="dialog" aria-modal="true" aria-label="Study Trail" inert>
    <div class="trail-dhead">
      <div class="trail-dtitle">✦ Study Trail</div>
      <button id="trailClose" class="trail-close" type="button" aria-label="Close study trail">×</button>
    </div>
    <div id="trailTabs" class="trail-tabs" role="tablist" aria-label="Study Trail views">
      <button data-tab="pinned" class="on" role="tab" aria-selected="true" type="button">Pinned Verses</button>
      <button data-tab="insights" role="tab" aria-selected="false" type="button">AI Insights</button>
    </div>
    <div class="trail-dbody">
      <div id="tab-pinned" role="tabpanel"></div>
      <div id="tab-insights" role="tabpanel" style="display:none"></div>
    </div>
  </aside>

  <script>
    import '../scripts/core';
    import '../scripts/panel';
    import '../scripts/studytrail';
    import '../scripts/saroop';
  </script>
</body>
</html>
