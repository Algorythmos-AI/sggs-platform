---
// Marketing.astro — the Gurbani Soul marketing shell for `/` (renamed from Landing.astro in the
// PR1 web-foundations pass). Separate from Base.astro (the Knowledge Base's own layout/name/theme,
// per docs/engineering/brand.md). Head SEO/social/PWA is delegated to <Seo>; brand styles live in
// ../styles/marketing.css; Vercel analytics is loaded only on gurbanisoul.com via <Analytics>.
// Visual output is unchanged from Landing.astro — the redesign is PR2.
import { ClientRouter } from "astro:transitions";
import Seo from "../components/Seo.astro";
import Analytics from "../components/Analytics.astro";
import GurpurabBanner from "../components/GurpurabBanner.astro";
import "../styles/marketing.css";
import { LOCALES } from "../i18n/locales";
import { localeOf } from "../i18n/paths";
import { useT } from "../i18n/t";
import { intlTag } from "../i18n/format";
export interface Props {
  title: string;
  description: string;
  path?: string;      // the page's own localized path, e.g. "/en/features" — for canonical + og:url
  ogImage?: string;   // absolute or root-relative; defaults to the path's OG card
  noindex?: boolean;  // a page built before its feature is launched: kept out of search and the sitemap
}
const { title, description, path = "/", ogImage, noindex = false } = Astro.props;
const lang = localeOf(Astro.url.pathname);
const locale = LOCALES[lang];
const { t } = useT(lang);
---
<!DOCTYPE html>
<html lang={locale.htmlLang} data-intl={intlTag(lang)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  {noindex && <meta name="robots" content="noindex, follow" />}
  <Seo title={title} description={description} path={path} ogImage={ogImage} themeColor="light" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Resolve theme before first paint. The marketing site is LIGHT-FIRST: with no stored choice
       it renders light whatever the OS appearance (the Knowledge Base's Base.astro keeps 'system').
       An explicit choice (localStorage 'theme', shared with the KB) always wins. The single
       theme-color meta follows the resolved page theme (scripts/theme.ts keeps it in step). -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme') || 'light';
        var d = t === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        document.documentElement.setAttribute('data-theme', d);
        var m = document.getElementById('themeColorMeta');
        if (m) m.setAttribute('content', d === 'dark' ? '#171412' : '#FBF7F0');
      } catch (e) {}
    })();
  </script>
  <!-- Gurpurab banner (components/GurpurabBanner.astro): decided before first paint so nothing
       shifts. Shown only on the reader's own 24 Nov 2026, inside a hard UTC window (the 24th from
       UTC+14 to UTC-10), unless dismissed. Hidden under automation (navigator.webdriver) unless a
       test sets gp557_force, so other suites and Lighthouse see the page as it is. ClientRouter
       copies the new page's <html> attributes on a swap, so astro:after-swap decides again. -->
  <script is:inline>
    (function () {
      function get(k) { try { return window.localStorage.getItem(k); } catch (e) { return null; } }
      function decide() {
        var on = false;
        try {
          var now = Date.now(), d = new Date(now);
          var day = d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate();
          on = day === 20261124 && now >= Date.UTC(2026, 10, 23, 10) && now < Date.UTC(2026, 10, 25, 10);
          if (on && (window.__gp557hide || get('gp557_dismissed') === '1')) on = false;
          if (on && navigator.webdriver && !window.__gp557force && get('gp557_force') !== '1') on = false;
        } catch (e) { on = false; }
        if (on) document.documentElement.setAttribute('data-gp557', '');
        else document.documentElement.removeAttribute('data-gp557');
      }
      decide();
      if (!window.__gp557bound) {
        window.__gp557bound = true;
        document.addEventListener('astro:after-swap', decide);
      }
    })();
  </script>
  <link rel="preload" href="/fonts/SantLipi-VF.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/SourceSerif4-latin.woff2" as="font" type="font/woff2" crossorigin />
  <ClientRouter />
  <slot name="head" />
</head>
<body>
  <a href="#main" class="lp-skip">{t("shell.skipToContent")}</a>
  <GurpurabBanner />
  <main id="main"><slot /></main>
  <Analytics />
  <script>
    // Registers the landing's astro:page-load / before-swap / after-swap listeners exactly once.
    import "../scripts/landing.ts";
  </script>
</body>
</html>
