---
// Analytics.astro — privacy-scoped Vercel Web Analytics loader using the official @vercel/analytics
// package. The analytics script is injected ONLY when the page is served from gurbanisoul.com (or a
// subdomain); on serve.py/localhost/staging it is a true no-op, so nothing is loaded and no request
// is made. The hostname guard ensures analytics only run in production.
---
<script>
  // Import and inject Vercel Analytics only in production
  import { inject } from '@vercel/analytics';
  
  // Only inject analytics if running on production domain
  if (/(^|\.)gurbanisoul\.com$/.test(location.hostname)) {
    inject();
  }
</script>
