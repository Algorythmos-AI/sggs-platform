---
// Figures.astro — a row of counts set large in Source Serif, each with a short label: the
// structural facts behind a chapter (e.g. 22 Vaars · 471 pauris · 972 saloks). Values come from
// src/facts.ts, never typed by hand. Data, not app UI: it never imitates a screen.
//   stack  true = one figure per row, larger (a chapter's media column); default = a row of figures
interface Props {
  items: { n: string; l: string }[];
  label: string;
  stack?: boolean;
}
const { items, label, stack = false } = Astro.props;
---
<ul class:list={["figs", { "figs--stack": stack }]} aria-label={label}>
  {items.map((f) => <li><strong>{f.n}</strong><span>{f.l}</span></li>)}
</ul>

<style>
  .figs { list-style: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 120px), 1fr)); border-top: 1px solid var(--line); }
  .figs li { display: flex; flex-direction: column; gap: 4px; padding: 16px 16px 4px 0; min-width: 0; }
  .figs strong { font-family: var(--serif-display); font-weight: 600; font-size: clamp(28px, 3.4vw, 40px); line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums lining-nums; }
  .figs span { font-size: 14px; line-height: 1.4; color: var(--ink-soft); }

  /* The large stack only where it has a column of its own; on phones it stays a compact row. */
  @media (min-width: 980px) {
    .figs--stack { margin: 0; grid-template-columns: minmax(0, 1fr); }
    .figs--stack li { padding: 28px 0; border-bottom: 1px solid var(--line); gap: 8px; }
    .figs--stack strong { font-size: clamp(56px, 6vw, 76px); letter-spacing: -.02em; }
    .figs--stack span { font-size: 15.5px; max-width: 34ch; }
  }
</style>
