---
// Breadcrumbs.astro — Home / Learn / {title} trail with a matching BreadcrumbList JSON-LD.
import JsonLd from "./JsonLd.astro";
import { SITE_URL } from "../site";
import { localeOf, localizeHref } from "../i18n/paths";
import { useT } from "../i18n/t";

const lang = localeOf(Astro.url.pathname);
const L = (href: string) => localizeHref(href, lang);
const { t } = useT(lang);

export interface Props { title: string; slug?: string }
const { title, slug } = Astro.props;

const trail = [
  { name: t("breadcrumbs.home"), url: new URL(L("/"), SITE_URL).href },
  { name: t("breadcrumbs.learn"), url: new URL(L("/learn"), SITE_URL).href },
  { name: title, url: slug ? new URL(L(`/learn/${slug}`), SITE_URL).href : undefined },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: trail.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    ...(c.url ? { item: c.url } : {}),
  })),
};
---
<nav class="crumbs" aria-label={t("breadcrumbs.label")}>
  <ol>
    <li><a href={L("/")}>{t("breadcrumbs.home")}</a></li>
    <li><a href={L("/learn")}>{t("breadcrumbs.learn")}</a></li>
    <li aria-current="page">{title}</li>
  </ol>
</nav>
<JsonLd data={jsonLd} />

<style>
  .crumbs ol {
    list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap;
    gap: 8px; font-size: 13.5px; color: var(--ink-soft);
  }
  .crumbs li { display: inline-flex; align-items: center; gap: 8px; }
  .crumbs li + li::before { content: "/"; color: var(--line); }
  .crumbs a { color: var(--accent-text); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs li[aria-current="page"] { color: var(--ink-soft); }
</style>
