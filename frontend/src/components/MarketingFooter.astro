---
// MarketingFooter.astro — the one footer for every Gurbani Soul marketing page (replaces the five
// hand-copied `<footer class="foot">` blocks). Brand block + four link columns inside a single
// nav[aria-label="Footer"], then the credits. Credits are DATA-DRIVEN from IMAGE_CREDITS
// (site.ts): artwork entries (no url) → "Artwork: …"; Unsplash photographs (with url) →
// "Photographs: {who} / Unsplash … (Unsplash License)", rendered only when such photos exist. The
// imagery-credit gate reads every `who` from the built HTML, so a new photo cannot ship uncredited.
import { getCollection } from "astro:content";
import { SUPPORT_EMAIL, IMAGE_CREDITS, APP_STORE_URL, APP_STORE_LIVE } from "../site";
import { CONTRIBUTE_MODE } from "../contribute";
import { LEARN_SLUGS } from "../routes";
import { localeOf, localizeHref } from "../i18n/paths";
import { learnHref, articleLangFor } from "../i18n/content";
import { useT } from "../i18n/t";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = localeOf(Astro.url.pathname);
const L = (href: string) => localizeHref(href, lang);
const { t, rich } = useT(lang);

// The first three Learn articles, in the curated LEARN_SLUGS order (drafts excluded).
const order = new Map(LEARN_SLUGS.map((s, i) => [s, i]));
const learnTop = (await getCollection("learn"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => (order.get(a.id) ?? 999) - (order.get(b.id) ?? 999))
  .slice(0, 3);

// Contribute sits under the brand blurb, not in the Support (help) column. Only when links exist.
const giveOn = CONTRIBUTE_MODE !== "off";

const year = new Date().getFullYear();
const artwork = IMAGE_CREDITS.filter((c) => !c.url);
const photos = IMAGE_CREDITS.filter((c) => c.url);

const columns: { title: string; links: { href: string; label: string; lang?: string }[] }[] = [
  {
    title: t("footer.product"),
    links: [
      { href: L("/features"), label: t("nav.features") },
      { href: L("/watch"), label: t("nav.watch") },
      { href: "/search", label: t("nav.knowledgeBase") },
    ],
  },
  {
    title: t("footer.learn"),
    links: [
      ...learnTop.map((a) => ({ href: learnHref(lang, a.id), label: a.data.title, lang: articleLangFor(lang, a.id) !== lang ? "en" : undefined })),
      { href: L("/learn"), label: t("footer.allArticles") },
      { href: "/rss.xml", label: t("footer.rss") },
    ],
  },
  {
    title: t("footer.support"),
    links: [
      { href: L("/support"), label: t("footer.support") },
      { href: `mailto:${SUPPORT_EMAIL}`, label: SUPPORT_EMAIL },
      { href: L("/support#contact"), label: t("footer.reportError") },
    ],
  },
];
---
<footer class="foot mfoot">
  <!-- Top row: the name, one line, and the two actions (an outlined App Store link once live — the
       gold fill stays with the nav and the page's own CTAs — and the theme toggle, which drives
       #themeBtn via [data-theme-proxy]). -->
  <div class="wrap mfoot-top">
    <div>
      <p class="mfoot-name"><span class="gm" aria-hidden="true">ੴ</span> <span>{t("shell.brandName")}</span></p>
      <p class="mfoot-tag">{t("footer.tagline")}</p>
    </div>
    <div class="mfoot-act">
      {APP_STORE_LIVE && <a class="mfoot-store" href={APP_STORE_URL} aria-label={t("nav.getAppLabel")}>{t("footer.downloadOnStore")}</a>}
      <LanguageSwitcher variant="footer" />
      <button class="mnav-icon mfoot-theme" data-theme-proxy aria-label={t("nav.theme")}>◐</button>
    </div>
  </div>
  <div class="wrap mfoot-in">
    <div class="mfoot-brand">
      <p class="mfoot-blurb">{t("footer.blurb")}</p>
      {giveOn && <p class="mfoot-give">{rich("footer.give").map((p) => typeof p === "string" ? p : <a href={L("/contribute")}>{p.text} <span aria-hidden="true">→</span></a>)}</p>}
    </div>
    <nav aria-label={t("footer.navLabel")} class="mfoot-nav">
      {columns.map((col) => (
        <div class="mfoot-col">
          <h2 class="mfoot-h">{col.title}</h2>
          <ul>
            {col.links.map((l) => <li><a href={l.href} lang={l.lang} hreflang={l.lang}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
      <div class="mfoot-col">
        <h2 class="mfoot-h">{t("footer.legal")}</h2>
        <ul>
          <li><a href={L("/privacy")}>{t("nav.privacy")}</a></li>
          <li class="mfoot-sub">{t("footer.fontLicences")}</li>
          <li><a href="/fonts/OFL.txt">{t("footer.santLipiLicence")}</a></li>
          <li><a href="/fonts/OFL-SourceSerif4.txt">{t("footer.serifLicence")}</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="wrap mfoot-bottom">
    <p class="mfoot-copy">{t("footer.copyright", { year: String(year) })}</p>
  <div class="credits">
    {artwork.map((c) => (
      <p>{t("footer.artwork", { what: c.what, who: c.who })}</p>
    ))}
    {photos.length > 0 && (
      <p>{rich("footer.photographs").map((p) => typeof p === "string" ? p : photos.map((c, i) => (
        <Fragment>{i > 0 && ", "}{rich("footer.photoCredit", { who: c.who }).map((q) => typeof q === "string" ? q : <a href={c.url}>{q.text}</a>)}</Fragment>
      )))}</p>
    )}
    <p>{t("footer.type")}</p>
  </div>
  </div>
</footer>

<style>
  .mfoot { border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 14px; background: var(--paper); }
  .mfoot-top { padding-top: clamp(40px, 6vw, 64px); padding-bottom: clamp(28px, 4vw, 40px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; border-bottom: 1px solid var(--line); }
  .mfoot-top .mfoot-name { font-size: clamp(24px, 2.6vw, 30px); }
  .mfoot-top .mfoot-name .gm { font-size: 1.15em; }
  .mfoot-tag { margin: 0; font-family: var(--serif-display); font-size: 17px; color: var(--ink-soft); }
  .mfoot-act { display: flex; align-items: center; gap: 10px; }
  .mfoot-store { display: inline-flex; align-items: center; height: 44px; padding: 0 20px; border-radius: 999px; border: 1px solid var(--line); color: var(--ink); font-weight: 650; font-size: 15px; text-decoration: none; }
  .mfoot-store:hover { border-color: var(--accent); }
  .mfoot-theme { --nav-edge: var(--line); width: 44px; height: 44px; color: var(--ink); }
  .mfoot-in { padding-top: clamp(36px, 5vw, 56px); padding-bottom: 28px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; }
  .mfoot-name { margin: 0 0 6px; display: flex; align-items: baseline; gap: 10px; font-family: var(--serif-display); font-size: 19px; font-weight: 600; color: var(--ink); }
  .mfoot-name .gm { font-size: 22px; line-height: 1; color: var(--ink); }
  .mfoot-blurb { margin: 0; max-width: 44ch; line-height: 1.55; }
  .mfoot-give { margin: 14px 0 0; max-width: 44ch; line-height: 1.55; }
  .mfoot-give a { color: var(--accent-text); font-weight: 650; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; display: inline-flex; align-items: center; gap: 5px; min-height: 44px; }
  .mfoot-give a:hover { text-decoration-color: var(--accent); }
  .mfoot-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 24px; }
  .mfoot-h { font-family: var(--sans); font-size: 12.5px; font-weight: 700; letter-spacing: .14em; color: var(--ink); margin: 0 0 12px; }
  .mfoot-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .mfoot-col li { line-height: 1.45; }
  .mfoot-col li.mfoot-sub { margin-top: 10px; font-size: 12.5px; color: var(--ink-soft); }
  .mfoot-col a { color: var(--accent-text); text-decoration: none; display: inline-block; padding: 6px 0; }
  .mfoot-col a:hover { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .mfoot-bottom { padding-top: 20px; padding-bottom: max(40px, env(safe-area-inset-bottom, 0px)); display: grid; gap: 10px 40px; border-top: 1px solid var(--line); }
  .mfoot-copy { margin: 0; color: var(--ink); font-size: 13.5px; }
  .credits { display: grid; gap: 4px; }
  @media (min-width: 980px) { .mfoot-bottom { grid-template-columns: auto minmax(0, 1fr); } .credits { text-align: right; } }
  .credits p { margin: 0; }
  @media (min-width: 980px) {
    .mfoot-in { grid-template-columns: 4fr 8fr; gap: 56px; }
    .mfoot-nav { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 979px) {
    .mfoot-col a { min-height: 44px; display: inline-flex; align-items: center; padding: 0; }
  }
  @media (max-width: 419px) {
    .mfoot-nav { grid-template-columns: minmax(0, 1fr); }
  }
</style>
