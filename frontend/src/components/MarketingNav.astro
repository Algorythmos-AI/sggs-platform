---
// MarketingNav.astro — sticky top bar for every Gurbani Soul marketing page. Three zones on one
// centre line: brand · primary links · actions (theme, Contribute, the one gold "Get the app").
// One capsule in every language (dark glass with white text over the hero, paper glass once
// scrolled or on solid pages — the header's height never changes, so nothing shifts) with a gold
// reading-progress hairline. Type is large for older readers: 18px Latin, Gurmukhi optically matched,
// 44px targets. ≥1600 full row · 1440–1599 Contribute shows its heart and the switcher its code ·
// <1440 links/theme/Contribute/languages move into the <dialog> sheet (same breakpoint for every
// language, so French never crowds) · <420 only brand + menu (the hero's App Store button is on screen). Styles in marketing.css, behaviour in landing.ts.
// The CTA is a real App Store link only when APP_STORE_LIVE; otherwise a "Coming soon" chip, tagged
// data-app-store="coming-soon-nav" so the page's single canonical "coming soon" stays the hero one.
// Contribute: an outlined button with a small heart — the heart's fill is the site's one use of
// brand red (--contribute-heart, owner exception; never text, never beside Gurmukhi). Renders only
// when /contribute has live/test links (CONTRIBUTE_MODE). Privacy lives in the sheet and the footer.
import { APP_STORE_URL, APP_STORE_LIVE } from "../site";
import { CONTRIBUTE_MODE } from "../contribute";
import { localeOf, localizeHref } from "../i18n/paths";
import { useT } from "../i18n/t";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = localeOf(Astro.url.pathname);
const L = (href: string) => localizeHref(href, lang);
const { t } = useT(lang);

// `overHero` (default) floats the bar over the dark hero with white text until scrolled. Pages with
// no dark hero (e.g. Learn, Features, The watch) pass overHero={false} so the resting bar uses ink
// text on paper — otherwise white-on-paper fails colour contrast.
export interface Props { overHero?: boolean }
const { overHero = true } = Astro.props;

// Active state is by PATHNAME: aria-current="page" on the link whose href matches the current path.
// landing.ts re-asserts this after each ClientRouter swap (see wireNavActive).
const here = (Astro.url.pathname || "/").replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/+$/, "") || "/") === here;
const giveOn = CONTRIBUTE_MODE !== "off";
const heart = '<svg class="heart" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 21.2c-.3 0-.6-.1-.8-.3C8.2 18.4 2.5 13.9 2.5 8.9A5.2 5.2 0 0 1 12 6a5.2 5.2 0 0 1 9.5 2.9c0 5-5.7 9.5-8.7 12-.2.2-.5.3-.8.3z"/></svg>';

const links = [
  { href: L("/features"), label: t("nav.features"), prefetch: true },
  { href: L("/watch"), label: t("nav.watch"), prefetch: true },
  { href: L("/learn"), label: t("nav.learn"), prefetch: true },
  { href: "/search", label: t("nav.knowledgeBase") },
  { href: L("/support"), label: t("nav.support"), prefetch: true },
];
---
<header class:list={["mnav", { "mnav--solid": !overHero }]} id="mnav">
  <div class="mnav-in">
    <a class="brand" href={L("/")}>
      <span class="gm" aria-hidden="true">ੴ</span>
      <span>{t("shell.brandName")}</span>
    </a>

    <nav class="mnav-links" aria-label={t("nav.primaryLabel")}>
      {links.map((l) => (
        <a href={l.href} data-astro-prefetch={l.prefetch ? "" : undefined}
           aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="mnav-right">
      <LanguageSwitcher variant="nav" />
      <button id="themeBtn" class="mnav-icon" aria-label={t("nav.theme")}>◐</button>
      {giveOn && (
        <a class="mnav-give" href={L("/contribute")} data-astro-prefetch
           aria-current={isCurrent(L("/contribute")) ? "page" : undefined}>
          <Fragment set:html={heart} /><span class="lbl">{t("nav.contribute")}</span>
        </a>
      )}
      {APP_STORE_LIVE
        ? <a class="pill" href={APP_STORE_URL} aria-label={t("nav.getAppLabel")}>{t("nav.getApp")}</a>
        : <span class="pill soon" data-app-store="coming-soon-nav">{t("nav.comingSoon")}</span>}
      <button class="burger mnav-icon" aria-expanded="false" aria-controls="mobileMenu" aria-label={t("nav.openMenu")}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8.5h16M4 15.5h16" /></svg>
      </button>
    </div>
    <span class="mnav-progress" aria-hidden="true"></span>
  </div>
</header>

<dialog id="mobileMenu" aria-label={t("nav.menuLabel")}>
  <div class="mm-in">
    <div class="mm-top">
      <a class="brand" href={L("/")}><span class="gm" aria-hidden="true">ੴ</span> <span>{t("shell.brandName")}</span></a>
      <button class="mm-close mnav-icon" aria-label={t("nav.closeMenu")}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <nav class="mm-links" aria-label={t("nav.menuLabel")}>
      {links.map((l) => (
        <a href={l.href} data-astro-prefetch={l.prefetch ? "" : undefined}
           aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="mm-sub">
      <a href={L("/privacy")} data-astro-prefetch aria-current={isCurrent(L("/privacy")) ? "page" : undefined}>{t("nav.privacy")}</a>
      {giveOn && (
        <a class="mm-give" href={L("/contribute")} data-astro-prefetch
           aria-current={isCurrent(L("/contribute")) ? "page" : undefined}>
          <Fragment set:html={heart} /><span>{t("nav.contribute")}</span>
        </a>
      )}
    </div>
    <LanguageSwitcher variant="sheet" />
    <div class="mm-actions">
      {APP_STORE_LIVE
        ? <a class="pill mm-cta" href={APP_STORE_URL} aria-label={t("nav.getAppLabel")}>{t("nav.getApp")}</a>
        : <span class="pill soon mm-cta" data-app-store="coming-soon-nav">{t("nav.comingSoon")}</span>}
      <button class="mm-theme mnav-icon" data-theme-proxy aria-label={t("nav.theme")}>◐</button>
    </div>
  </div>
</dialog>
