---
// Seo.astro — the shared <head> SEO/social/PWA block for both the marketing shell and the
// Knowledge Base (Base.astro). Emits an absolute canonical + Open Graph/Twitter (with the card's size, type and alt)/theme-color/
// manifest set, plus hreflang alternates for the marketing pages (i18n/content.ts alternates()).
// Does NOT emit <title> (the layout owns it).
import { SITE_URL, APP_STORE_ID, APP_STORE_LIVE } from "../site";
import { ogForPath, ogImagePath } from "../routes";
import { SHARE } from "../share";
import kbThemes from "../generated/kb-themes.json";
import { LOCALES } from "../i18n/locales";
import { localeOf } from "../i18n/paths";
import { alternates as altsFor } from "../i18n/content";
import { useT } from "../i18n/t";

export interface Props {
  title: string;
  description: string;
  path: string;          // root-relative, e.g. "/en" or "/search" (marketing paths carry their language)
  ogImage?: string;      // root-relative or absolute; defaults to the path's OG card
  imageAlt?: string;     // the card's alt text when ogImage is a page's own card
  type?: string;         // og:type, default "website"
  // Browser-chrome colour: always ONE meta that follows the PAGE theme, never the OS, so a
  // dark-OS visitor never gets dark browser chrome over a light page (or the reverse).
  // "page" (default, the Knowledge Base) = id="kbThemeColor", the header's colour: the default
  // theme's by day here, corrected before first paint by Base.astro's boot script and kept current
  // by scripts/core.ts. "light" (the light-first marketing shell) = id="themeColorMeta", pinned to
  // paper and rewritten by scripts/theme.ts on toggle.
  themeColor?: "page" | "light";
}
const { title, description, path, ogImage, imageAlt: ownAlt, type = "website", themeColor = "page" } = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogLocale = LOCALES[localeOf(path)].ogLocale;
const brand = useT(localeOf(path)).t("shell.brandName"); // the wordmark in the page's language
// The page's language versions (none outside the marketing site), and their og:locale values.
const alternates = altsFor(path).map((a) => ({ ...a, href: new URL(a.href, SITE_URL).href }));
const ogAlternates = alternates.filter((a) => a.lang && LOCALES[a.lang].ogLocale !== ogLocale).map((a) => LOCALES[a.lang!].ogLocale);
const slug = ogForPath(path);
const ogPath = ogImage ?? ogImagePath(slug);
const ogAbsolute = new URL(ogPath, SITE_URL).href;
// What a shared link says (share.ts): a description short enough to unfurl whole (≤ 125), and a
// shorter og:title where the page title is too long. Pages without an entry (learn articles) use
// their own title and description.
const share = SHARE[slug] && !ogImage ? SHARE[slug] : undefined;
const socialTitle = share?.ogTitle ?? title;
const social = share?.social ?? description;
// Alt text for the card: what the image says, for screen readers in every client that reads it.
const imageAlt = ownAlt ?? (share ? [share.eyebrow, share.title].filter(Boolean).join(": ") + ` (${brand})` : `${socialTitle} (${brand})`);
const kbChrome = kbThemes.themes.find((t) => t.id === kbThemes.default)!.chrome.light;
---
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={brand} />
<meta property="og:locale" content={ogLocale} />
{ogAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={social} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogAbsolute} />
<meta property="og:image:secure_url" content={ogAbsolute} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={social} />
<meta name="twitter:image" content={ogAbsolute} />
<meta name="twitter:image:alt" content={imageAlt} />

{themeColor === "light"
  ? <meta name="theme-color" content="#FBF7F0" id="themeColorMeta" />
  : <meta name="theme-color" content={kbChrome} id="kbThemeColor" />}

<link rel="manifest" href="/site.webmanifest" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content={brand} />
{APP_STORE_LIVE && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}
