---
// Seo.astro — the shared <head> SEO/social/PWA block for both the marketing shell and the
// Knowledge Base (Base.astro). Emits an absolute canonical + Open Graph/Twitter/theme-color/
// manifest set. Does NOT emit <title> (the layout owns it). No hreflang here — locale alternates
// live only in sitemap.xml until the `pa` pages exist.
import { SITE_URL, APP_STORE_ID, APP_STORE_LIVE } from "../site";
import { ogForPath } from "../routes";
import kbThemes from "../generated/kb-themes.json";

export interface Props {
  title: string;
  description: string;
  path: string;          // root-relative, e.g. "/" or "/search"
  ogImage?: string;      // root-relative or absolute; defaults to the path's OG card
  type?: string;         // og:type, default "website"
  // Browser-chrome colour: always ONE meta that follows the PAGE theme, never the OS, so a
  // dark-OS visitor never gets dark browser chrome over a light page (or the reverse).
  // "page" (default, the Knowledge Base) = id="kbThemeColor", the header's colour: the default
  // theme's by day here, corrected before first paint by Base.astro's boot script and kept current
  // by scripts/core.ts. "light" (the light-first marketing shell) = id="themeColorMeta", pinned to
  // paper and rewritten by scripts/theme.ts on toggle.
  themeColor?: "page" | "light";
}
const { title, description, path, ogImage, type = "website", themeColor = "page" } = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogPath = ogImage ?? `/og/${ogForPath(path)}.png`;
const ogAbsolute = new URL(ogPath, SITE_URL).href;
const kbChrome = kbThemes.themes.find((t) => t.id === kbThemes.default)!.chrome.light;
---
<link rel="canonical" href={canonical} />
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Gurbani Soul" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogAbsolute} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogAbsolute} />

{themeColor === "light"
  ? <meta name="theme-color" content="#FBF7F0" id="themeColorMeta" />
  : <meta name="theme-color" content={kbChrome} id="kbThemeColor" />}

<link rel="manifest" href="/site.webmanifest" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Gurbani Soul" />
{APP_STORE_LIVE && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}
