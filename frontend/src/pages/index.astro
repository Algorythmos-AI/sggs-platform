  <style>
    #top { scroll-margin-top: 76px; }
    [data-chapter] { scroll-margin-top: 72px; }

    /* 1 · Hero */
    .hero { position: relative; min-height: min(94svh, 880px); display: flex; align-items: center;
      overflow: clip; margin-top: calc(-1 * var(--mnav-h)); background: #17110a; }
    .hero-media, .hero-media :global(.hero-pic), .hero-media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
    .hero-media { background: #17110a; }
    .hero-media :global(img) { object-fit: cover; object-position: center 46%; }
    /* The copy must read at 4.5:1 over the brightest sky and the lit dome behind it (measured on the
       rendered page, not assumed): a stronger pool behind the text column, and below 980px — where
       the copy spans the full width — an even veil. */
    .hero-scrim { position: absolute; inset: 0;
      background:
        radial-gradient(110% 85% at 20% 50%, rgba(15,10,5,.70) 0%, rgba(15,10,5,.42) 44%, transparent 76%),
        linear-gradient(180deg, rgba(15,10,5,.50) 0%, rgba(15,10,5,.30) 34%, rgba(15,10,5,.74) 100%); }
    @media (max-width: 979px) {
      .hero-scrim { background: linear-gradient(180deg, rgba(15,10,5,.64) 0%, rgba(15,10,5,.60) 55%, rgba(15,10,5,.80) 100%); }
    }
    .hero-in { position: relative; width: 100%; padding-top: calc(var(--mnav-h) + 56px); padding-bottom: 96px; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: center; }
    .hero-copy { color: #fff; min-width: 0; }
    .hero-copy .eyebrow { color: #f4d38a; }
    .hero-copy h1 { font-size: clamp(46px, 7.2vw, 112px); margin: 0 0 18px; color: #fff; line-height: 1; letter-spacing: -.025em; }
    .hero-lede { font-family: var(--serif-display); font-size: clamp(18px, 2.2vw, 26px); line-height: 1.4;
      max-width: 30ch; margin: 0 0 30px; color: #f3ead9; text-wrap: balance; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; }
    .hero-cta .pill { height: 48px; padding: 0 24px; font-size: 16px; }
    .hero-cta .pill .apple { width: 18px; height: 18px; margin-top: -2px; }
    .hero-cta .pill.soon { color: #fff; border-color: rgba(255,255,255,.6); }
    .hero-cta a.hero-ghost { color: #fff; text-decoration: underline; text-decoration-color: rgba(255,255,255,.5); text-underline-offset: 6px;
      font-weight: 600; font-size: 15.5px; display: inline-flex; align-items: center; min-height: 44px; }
    .hero-cta a.hero-ghost:hover { text-decoration-color: #fff; }
    .hero-chips { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .hero-chips li { font-size: 13.5px; line-height: 1; color: #efe5d2; padding: 7px 12px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,.24); background: rgba(255,255,255,.07); }
    /* The Reader phone: beside the copy from 980px; on phones it peeks up from the hero's foot,
       cropped by the hero (its image is eager either way, so this costs nothing). */
    .hero-device { display: flex; justify-content: center; position: relative; }
    .hero-device::before { content: ""; position: absolute; inset: -8% -6%; z-index: 0; pointer-events: none;
      background: radial-gradient(60% 55% at 50% 42%, rgba(255,188,13,.14), transparent 70%); }
    .hero-device :global(.device-fig) { position: relative; z-index: 1; }
    .hero-device :global(.device) { transform: rotate(-3deg); }
    @media (max-width: 979px) {
      .hero { align-items: flex-start; }
      .hero-in { padding-bottom: 0; }
      .hero-device { margin: 12px 0 calc(min(240px, 62vw) * -1.05); }
      .hero-device :global(.device-fig) { width: min(240px, 62vw); }
      .hero-device :global(.device) { max-width: none; }
    }
    @media (min-width: 980px) {
      .hero-grid { grid-template-columns: 1.05fr 0.95fr; gap: 56px; }
      .hero-device :global(.device) { width: min(340px, 90%); margin: 0 auto; }
    }
    @media (min-width: 1200px) { .hero-device :global(.device) { width: 368px; } }
    @media (min-width: 1800px) { .hero-device :global(.device) { width: 400px; max-width: 400px; } }
    /* Entrance (motion-safe): the copy rises 12px in a stagger with opacity held at 1 (so the LCP is
       never delayed); the phone settles from -8° and 40px lower, then one sheen crosses the glass. */
    @media (prefers-reduced-motion: no-preference) {
      .hero-rise { animation: gs-hero-rise .7s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--i, 0) * 80ms); }
      .hero-device :global(.device-fig) { animation: gs-phone-in .9s cubic-bezier(.16,1,.3,1) .15s both; }
      .hero-device :global(.screen)::after { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 1;
        background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,.32) 50%, transparent 65%);
        transform: translateX(-120%); animation: gs-sheen 1.4s ease 1s 1 both; }
    }
    /* The photo drifts slower than the page (up to 8% of the viewport) — a scroll-driven animation,
       so it runs on the compositor from the first paint (no script, no late re-raster). Browsers
       without scroll timelines, and reduced motion, keep it still. */
    @supports (animation-timeline: scroll()) {
      @media (prefers-reduced-motion: no-preference) {
        .hero-media :global(img) { animation: gs-hero-photo linear both; animation-timeline: scroll(root block); animation-range: 0 100vh; }
      }
    }
    @keyframes gs-hero-photo { from { transform: scale(1.06); } to { transform: translateY(8vh) scale(1.06); } }
    @keyframes gs-hero-rise { from { transform: translateY(12px); } }
    @keyframes gs-phone-in { from { opacity: 0; transform: translateY(40px) rotate(-5deg); } }
    @keyframes gs-sheen { to { transform: translateX(120%); } }

    /* 2 · Proof strip */
    .proof-sec { padding-bottom: 0; }

    /* 3 · Verse */
    .verse-band { margin-top: var(--sec-thin); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper-2); }
    .verse-in { padding: clamp(56px, 8vw, 96px) 20px; text-align: center; display: flex; flex-direction: column; align-items: center; }
    .gold-rule { margin: 0 0 28px; }
    .verse { font-size: clamp(21px, 3.2vw, 31px); line-height: 1.95; color: var(--ink); margin: 0; max-width: 24ch; }
    .cite { margin: 20px 0 0; color: var(--accent-text); font-weight: 600; font-size: 14px; letter-spacing: .01em; }
    .verse-note { margin: 10px auto 0; max-width: 58ch; color: var(--ink-soft); font-size: 14.5px; }

    /* 6 · Photo divider */
    .pb-sub { margin: 0 auto; max-width: 46ch; color: var(--ink-soft); font-size: clamp(16px, 1.8vw, 19px); line-height: 1.55; }
    :global(.photo-band) .h-statement { margin-bottom: 14px; }

    /* 11 · Verbatim */
    .never { margin: 22px 0 0; font-family: var(--serif-display); font-size: clamp(20px, 2.2vw, 24px); font-weight: 600; color: var(--accent-text); }

    /* 12 · Private */
    #story-private .stage :global(.device) { max-width: 280px; }

    /* 13 · Learn + KB */
    .all-link { margin: 18px 0 0; }
    .kb-bridge { margin-top: clamp(48px, 7vw, 88px); padding-top: clamp(40px, 6vw, 72px); border-top: 1px solid var(--line); }
    .kb-h { font-size: clamp(24px, 3vw, 34px); margin: 0 0 12px; color: var(--ink); }

    /* 14 · Download band */
    .dl-band { position: relative; overflow: clip; text-align: center; padding: var(--sec) 0; }
    .dl-art, .dl-art :global(picture), .dl-art :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
    .dl-art :global(img) { object-fit: cover; object-position: center 46%; opacity: .18; }
    /* warm-ink scrim over the faint artwork: keeps the centred statement ≥4.5:1 over the sun */
    .dl-art::after { content: ""; position: absolute; inset: 0; background: radial-gradient(70% 80% at 50% 50%, rgba(23,20,18,.6), rgba(23,20,18,.15) 80%); }
    .dl-in { position: relative; display: flex; flex-direction: column; align-items: center; }
    .dl-in .h-statement { max-width: 18ch; }
    .dl-body { margin-left: auto; margin-right: auto; max-width: 48ch; }
    .dl-cta { justify-content: center; }
    .dl-soon { color: var(--ink); border-color: var(--line); min-height: 44px; }
    .dl-fine { margin: 20px 0 0; color: var(--ink-soft); font-size: 14px; }
  </style>
</Marketing>
