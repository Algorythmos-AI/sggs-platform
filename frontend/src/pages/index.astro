---
// index.astro — the bare root, gurbanisoul.com/. Every marketing page lives under a language
// (/en, /pa, /fr), so the root only picks one.
//
// On gurbanisoul.com the root never reaches this page: vercel.json answers "/" with a 302 to the
// visitor's language, from the first language in Accept-Language (scripts/gen-i18n-redirects.mjs).
// Under serve.py, or any host without those rules, the inline script below makes the same choice in
// the browser before paint, and keeps a legacy "/?q=" search bookmark working. Without JavaScript
// the page is a plain language list. noindex: search engines index the language pages, which name
// each other (hreflang), never this hand-off.
import Marketing from "../layouts/Marketing.astro";
import { DEFAULT_LOCALE, ENABLED_LOCALES, LOCALES } from "../i18n/locales";

const choices = ENABLED_LOCALES.map((l) => ({ code: l, ...LOCALES[l] }));
const desc = "Gurbani Soul: a quiet, exact companion to Sri Guru Granth Sahib Ji. Choose your language.";
---
<Marketing title="Gurbani Soul" description={desc} path="/">
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
    <script is:inline define:vars={{ enabled: ENABLED_LOCALES, fallback: DEFAULT_LOCALE }}>
      (function () {
        try {
          if (/[?&]q=/.test(location.search)) { location.replace("/search" + location.search); return; }
          var first = ((navigator.languages && navigator.languages[0]) || navigator.language || "").toLowerCase();
          var tag = first.split(/[-_]/)[0];
          var pick = enabled.indexOf(tag) !== -1 ? tag : fallback;
          location.replace("/" + pick + location.hash);
        } catch (e) {}
      })();
    </script>
  </Fragment>
  <section class="lang-pick">
    <p class="lang-pick-mark"><span class="gm" aria-hidden="true">ੴ</span> Gurbani Soul</p>
    <ul class="lang-pick-list" aria-label="Language">
      {choices.map((c) => (
        <li><a class="btn ghost" href={`/${c.code}`} lang={c.htmlLang} hreflang={c.htmlLang}>{c.name}</a></li>
      ))}
    </ul>
  </section>
</Marketing>

<style>
  .lang-pick {
    min-height: 100vh; min-height: 100svh;
    display: grid; place-content: center; justify-items: center; gap: 28px;
    padding: 24px 16px; text-align: center;
  }
  .lang-pick-mark { font-family: var(--serif-display); font-size: clamp(28px, 6vw, 44px); margin: 0; }
  .lang-pick-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .lang-pick-list .btn { min-width: 160px; justify-content: center; }
</style>
