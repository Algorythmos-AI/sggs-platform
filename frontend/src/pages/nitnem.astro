---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Sri Guru Granth Sahib Ji — Nitnem">
  <section id="v-nitnem">
    <div id="nitnemList" class="nitnem-list"></div>
    <div id="nitnemReader" class="nitnem-reader" hidden>
      <!-- the same bar as the Reader's: the way back, the version where there are two, reading options -->
      <div class="toolbar">
        <button id="nitnemBack" class="tb-btn" type="button" aria-label="Back to the bani list">‹ Banis</button>
        <span id="nitnemVariants" class="tb-variants"></span>
        <button id="nitnemOptsBtn" class="tb-btn tb-aa" type="button" aria-haspopup="dialog" aria-expanded="false"
                aria-controls="nitnemOpts" aria-label="Reading options">ਅA</button>
      </div>
      <div id="baniHead" class="raagbanner"></div>
      <div id="baniOut"></div>
    </div>
  </section>
  <div id="nitnemOptsScrim" class="ro-scrim" aria-hidden="true"></div>
  <div id="nitnemOpts" class="ro" role="dialog" aria-modal="true" aria-label="Reading options" inert>
    <div class="ro-size">
      <button id="fontMinus" class="ro-step" type="button" aria-label="Smaller text">ਅ−</button>
      <span class="ro-sample gm" lang="pa" aria-hidden="true">ੳ ਅ ੲ</span>
      <button id="fontPlus" class="ro-step" type="button" aria-label="Larger text">ਅ+</button>
    </div>
    <div class="tgl" id="tglT" role="switch" tabindex="0" aria-checked="true" aria-label="show transliteration">
      <span>Transliteration</span><span class="sw"></span></div>
  </div>
  <script>import '../scripts/nitnem';</script>
</Base>
