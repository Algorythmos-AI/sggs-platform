---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Sri Guru Granth Sahib Ji — Search">
  <section id="v-search">
    <div class="searchbar">
      <div class="sb-field">
        <input id="q" class="gm" type="search" enterkeyhint="search" autocomplete="off" autocapitalize="off" spellcheck="false"
               aria-label="Search Sri Guru Granth Sahib Ji" placeholder="ਨਾਮੁ · waheguru · ਸ ਨ ਕ · naam" />
        <button id="qClear" class="sb-clear" type="button" aria-label="Clear the search" hidden>×</button>
      </div>
      <button class="sb-go" onclick="go(0)">Search</button>
    </div>
    <div class="modes" id="modes" role="radiogroup" aria-label="Search mode">
      <button type="button" data-m="auto" class="on">Auto</button><button type="button" data-m="gurmukhi">Gurmukhi</button>
      <button type="button" data-m="roman">Roman</button><button type="button" data-m="english">English</button>
      <button type="button" data-m="first">First letters</button><button type="button" data-m="theme">Theme</button>
      <button type="button" data-m="verify">Verify quote</button>
    </div>
    <!-- before anything is typed: what this mode takes (as in the app) -->
    <div id="searchIdle" class="search-idle"></div>
    <div id="results" aria-live="polite" aria-atomic="false"></div>
  </section>
  <script>import '../scripts/search';</script>
</Base>
