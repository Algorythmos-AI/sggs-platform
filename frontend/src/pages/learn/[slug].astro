---
// The pre-i18n article URLs. vercel.json answers them with a 308 to /en/learn/<slug>; these pages
// cover serve.py.
import { getCollection } from "astro:content";
import LegacyRedirect from "../../components/LegacyRedirect.astro";

export async function getStaticPaths() {
  return (await getCollection("learn"))
    .filter((e) => !e.data.draft)
    .map((e) => ({ params: { slug: e.id } }));
}
const { slug } = Astro.params;
---
<LegacyRedirect to={`/en/learn/${slug}`} />
