---
// library.astro — the Knowledge Base home (/library): the current pahar, search, the places
// this browser was last reading, and a door into every tool. The search form and the doors are
// plain HTML, so the page works before (and without) its script.
import Base from '../layouts/Base.astro';

const dot = (cx: number, cy: number, r: number) =>
  `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0z`;
const DOORS = [
  { href: '/reader', name: 'Reader', sub: 'All 1430 Angs, verbatim', d: 'M5 5h9a3 3 0 0 1 3 3v12H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h9' },
  { href: '/nitnem', name: 'Nitnem', sub: 'Daily banis, your place kept', d: 'M3 18h18M7 18a5 5 0 0 1 10 0M12 6v3M5.5 9.5l2 2M18.5 9.5l-2 2' },
  { href: '/browse', name: 'Index', sub: 'Compositions, raags and banis', d: 'M5 5h6v6H5zM13 5h6v6h-6zM5 13h6v6H5zM13 13h6v6h-6z' },
  { href: '/themes', name: 'Themes', sub: '54 concepts to search by', d: dot(12, 12, 2.2) + dot(12, 6.5, 2.6) + dot(12, 17.5, 2.6) + dot(6.5, 12, 2.6) + dot(17.5, 12, 2.6) },
  { href: '/constellation', name: 'Constellation', sub: "A concept's verses as a star map", d: 'M6 17l5-9 7 4' + dot(6, 17, 1.6) + dot(11, 8, 1.6) + dot(18, 12, 1.6) },
  { href: '/trail', name: 'Verse trail', sub: 'Walk from verse to related verse', d: 'M5 19c5-1 2-6 7-7s3-6 7-7' + dot(5, 19, 1.5) + dot(19, 5, 1.5) },
  { href: '/lineage', name: 'Contributors', sub: 'Gurus, Bhagats, Bhatts, Gursikhs', d: dot(12, 8, 3.5) + 'M5 20a7 7 0 0 1 14 0' },
  { href: '/analytics', name: 'Insights', sub: 'Patterns across raags and voices', d: 'M5 19V10M12 19V5M19 19v-7' },
  { href: '/raag-clock', name: 'Raag Clock', sub: 'Traditional timing, sources differ', d: dot(12, 12, 8.5) + 'M12 7v5l3 2' },
];
---
<Base title="ੴ Sri Guru Granth Sahib Ji — Library"
      description="The Knowledge Base home: search Sri Guru Granth Sahib Ji, carry on where you were reading, and open the Reader, Nitnem, the Index and the study tools.">
  <section id="v-library" class="hub">
    <div class="hub-now" id="hubNow" aria-live="polite"></div>
    <form class="searchbar hub-search" action="/search" method="get" role="search">
      <input id="hubQ" name="q" class="gm" aria-label="Search Sri Guru Granth Sahib Ji"
             placeholder="ਨਾਮੁ · waheguru · saadh sangat · ਧ ਧ ਰ ਗ · dh dh r g …" />
      <button type="submit">Search</button>
    </form>
    <div class="hub-row">
      <div class="hub-continue" id="hubContinue"></div>
      <button class="now-btn ghost hub-random" type="button" data-random>✦ Hukam-style random</button>
    </div>
    <h2 class="hub-h">Open a door</h2>
    <nav class="doors" aria-label="Knowledge Base tools">
      {DOORS.map((d) => (
        <a class="door" href={d.href}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={d.d} /></svg>
          <b>{d.name}</b><small>{d.sub}</small>
        </a>
      ))}
    </nav>
  </section>
  <script>import '../scripts/library';</script>
</Base>
