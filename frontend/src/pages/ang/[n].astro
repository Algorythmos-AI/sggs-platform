---
// /ang/N — the link every verse and Ang share carries (web verse sheet, iOS share sheet). A
// link-preview crawler reads this page's tags and gets Ang N's own card (og/v2/ang/N.png); a
// person is sent straight on to the Reader at that Ang (and line, when the link has ?line=).
// Crawlers do not run JavaScript, so the hand-off is a script, never a meta refresh (some
// crawlers follow a refresh and would unfurl the Reader's generic card instead).
//
// noindex, follow: the Reader is the page to index; these exist to be shared. They are not in
// routes.ts or the sitemap (the SitemapInvariants gate skips /ang/).
import Seo from "../../components/Seo.astro";
import data from "../../generated/ang-cards.json";
import { ogImagePath } from "../../routes";

export function getStaticPaths() {
  return Object.keys(data.angs).map((n) => ({ params: { n } }));
}

const { n } = Astro.params;
const ang = Number(n);
const raag = (data.angs as Record<string, { raag: string | null }>)[n!].raag;
const title = `Ang ${ang} · Sri Guru Granth Sahib Ji`;
const description = `Read Ang ${ang} of Sri Guru Granth Sahib Ji in verbatim Gurmukhi, cited by Ang, in the Gurbani Soul Knowledge Base.`;
const imageAlt = `Ang ${ang} of Sri Guru Granth Sahib Ji${raag ? ", in its raag," : ""} with its opening line in Gurmukhi (Gurbani Soul)`;
const reader = `/reader?ang=${ang}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <Seo title={title} description={description} path={`/ang/${ang}`} ogImage={ogImagePath(`ang/${ang}`)}
       imageAlt={imageAlt} type="article" themeColor="light" />
  <script is:inline define:vars={{ reader }}>
    var line = new URLSearchParams(location.search).get("line");
    location.replace(reader + (line && /^\d+$/.test(line) ? "&line=" + line : ""));
  </script>
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #FBF7F0; color: #201A12;
           font: 18px/1.5 "Source Serif 4", Georgia, serif; }
    a { color: #8A6100; }
  </style>
</head>
<body>
  <p>Opening <a href={reader}>Ang {ang} in the Reader</a>…</p>
</body>
</html>
