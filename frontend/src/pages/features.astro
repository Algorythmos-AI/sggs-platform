---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Marketing from "../layouts/Marketing.astro";
import MarketingNav from "../components/MarketingNav.astro";
import MarketingFooter from "../components/MarketingFooter.astro";
import ContributeBand from '../components/ContributeBand.astro';
import DeviceFrame from "../components/DeviceFrame.astro";
import FeatureChapter from "../components/FeatureChapter.astro";
import PhotoBand from "../components/PhotoBand.astro";
import JsonLd from "../components/JsonLd.astro";
import { SITE_URL } from "../site.ts";
import { FACTS, fmt, ordinal, spell, VOICE_CENTURIES } from "../facts.ts";
import widePhoto from "../assets/landing/unsplash-reubx-harmandir-sahib-wide.jpg";
import ipadReader from "../assets/app/ipad-reader-landscape-light.png";
import saroopOff from "../assets/app/iphone-saroop-off-light.png";
import saroopOn from "../assets/app/iphone-saroop-on-light.png";
import searchRoman from "../assets/app/iphone-search-roman-light.png";
import verifyShot from "../assets/app/iphone-verify-verdict-light.png";
import hukamShot from "../assets/app/iphone-hukam-light.png";
import ipadNitnem from "../assets/app/ipad-nitnem-landscape-light.png";
import journeyShot from "../assets/app/iphone-nitnem-journey-light.png";
import clockDark from "../assets/app/iphone-clock-dark.png";
import clockSolar from "../assets/app/iphone-clock-solar-dark.png";
import wRaag from "../assets/app/widget-raagnow-small-light.png";
import wHukamDark from "../assets/app/widget-hukam-medium-dark.png";
import wNitnemDark from "../assets/app/widget-nitnem-medium-dark.png";
import wNitnemSmall from "../assets/app/widget-nitnem-small-light.png";
import laCard from "../assets/app/iphone-live-activity-card.png";
import accentSoul from "../assets/app/accent-soul.png";
import accentSaffron from "../assets/app/accent-saffron.png";
import accentGold from "../assets/app/accent-gold.png";
import accentIndigo from "../assets/app/accent-indigo.png";
import accentTeal from "../assets/app/accent-teal.png";
import vaarWeave from "../assets/app/iphone-vaar-weave-light.png";
import vaarReader from "../assets/app/iphone-vaar-reader-light.png";
import indexShot from "../assets/app/iphone-index-light.png";
import raagGauri from "../assets/app/iphone-raag-gauri-light.png";
import voiceM9 from "../assets/app/iphone-voice-m9-light.png";
import compareShot from "../assets/app/iphone-compare-light.png";

const desc =
  "Everything Gurbani Soul does on your iPhone and iPad — read the whole Granth, search the way you remember, keep your Nitnem, receive the Hukam of the day, read the Vaars, and explore the Index, themes and voices. Verbatim, cited by Ang, fully offline.";

const ANGS = fmt(FACTS.angs);

// The 1.4.9 surfaces. Each list fills with the app's own screenshots (src/assets/app, provenance in
// SHOTS.md); while one is empty its chapter shows its copy and figures alone. Themes and Explore
// (Constellation) have no verified 1.4.9 shot yet.
const vaarShots: { src: ImageMetadata; alt: string; label?: string }[] = [
  { src: vaarWeave, label: "The weave",
    alt: "Maajh Ki Vaar on iPhone, Angs 137 to 150: its voices with their pauris and saloks, and the weave in reading order, each salok and pauri cited by Ang" },
  { src: vaarReader, label: "The reader",
    alt: "Maajh Ki Vaar open in the Vaar reader on iPhone: its printed heading, then the first salok with transliteration under each line" },
];
const indexShots: { src: ImageMetadata; alt: string; label?: string }[] = [
  { src: indexShot, label: "The saroop",
    alt: "The Index on iPhone: the saroop ribbon across 1,430 Angs, and the major compositions with their reading times" },
  { src: raagGauri, label: "A raag's page",
    alt: "Raag Gauri's page on iPhone: raag 3 of 31, Angs 151 to 346, its counts of shabads, verses, Angs and voices, and the voices in this raag" },
];
const themeShots: { src: ImageMetadata; alt: string; label?: string }[] = [];
const voiceShots: { src: ImageMetadata; alt: string; label?: string }[] = [
  { src: voiceM9, label: "A voice's page",
    alt: "The page for Guru Tegh Bahadur Ji on iPhone: dates, the Angs where their Bani appears, and counts of verses, compositions and raags" },
  { src: compareShot, label: "Compare",
    alt: "Compare on iPhone: Guru Tegh Bahadur Ji beside Guru Nanak Dev Ji, the Angs where each appears and how strongly each carries a theme" },
];
const exploreShots: { src: ImageMetadata; alt: string; label?: string }[] = [];

// At a glance — nine rows, each linking to its chapter below (a hairline 3×3 grid).
const glance = [
  { id: "reader", t: "Read the whole Granth", d: `All ${ANGS} Angs in Sant Lipi. Turn pages, jump to any Ang, resume where you left off.` },
  { id: "search", t: "Search how you remember", d: "By word, by sound in Roman letters, by first letters, or by theme — and verify a line you were sent." },
  { id: "hukam", t: "The Hukam of the day", d: "One complete Hukam for the whole day, in the app and from Siri, with its opening verse on a widget — or draw a fresh one." },
  { id: "nitnem", t: "Nitnem, with your place kept", d: "The daily banis by time of day, your place kept in each, and a quiet record of the days you read." },
  { id: "raag-clock", t: "The Raag Clock", d: "Which raags belong to this watch of the day — by fixed hours or by your local sunrise and sunset." },
  { id: "vaars", t: "The Vaars, as printed", d: `All ${FACTS.vaars} Vaars, pauri by pauri and salok by salok, with a reader that keeps your place.` },
  { id: "index", t: "An Index in saroop order", d: `The Granth from Ang 1 to Ang ${ANGS}, and a page for each of the ${FACTS.raags} raags.` },
  { id: "themes", t: `${FACTS.themes} themes`, d: "A page for every theme, a theme of the day, and the themes your own saved verses carry." },
  { id: "voices", t: "The voices of the Granth", d: `All ${FACTS.voices} voices, a page for each, and two side by side.` },
];

const accents = [
  { src: accentSoul, name: "Soul" },
  { src: accentSaffron, name: "Saffron" },
  { src: accentGold, name: "Gold" },
  { src: accentIndigo, name: "Indigo" },
  { src: accentTeal, name: "Teal" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: "Gurbani Soul", url: SITE_URL, inLanguage: "en" },
    {
      "@type": "WebPage",
      name: "Features — Gurbani Soul",
      description: desc,
      url: new URL("/features", SITE_URL).href,
      inLanguage: "en",
      isPartOf: { "@type": "WebSite", name: "Gurbani Soul", url: SITE_URL },
    },
  ],
};
---
<Marketing title="Features — Gurbani Soul" description={desc} path="/features">
  <JsonLd slot="head" data={jsonLd} />
  <MarketingNav overHero={false} />

  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Everything, on your device</p>
      <h1>Made for reading, not for scrolling</h1>
      <span class="gold-hair" aria-hidden="true"></span>
      <p class="lede">The whole Granth, the daily banis and the study tools — quiet, exact, and entirely
        on your device. No feeds, no accounts, nothing asking for your attention.</p>
    </div>
  </header>

  <!-- At a glance: nine capabilities, each anchoring its chapter -->
  <section class="sec-thin glance-sec" aria-labelledby="glance-h">
    <div class="wrap">
      <h2 id="glance-h" class="glance-h">At a glance</h2>
      <dl class="feat-list">
        {glance.map((f) => (
          <div class="feat-row reveal">
            <dt><a href={`#${f.id}`}>{f.t}</a></dt>
            <dd>{f.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 1 · READER — full-width iPad, editorial -->
  <section class="sec surface-paper hair-top" id="reader" data-chapter="reader">
    <div class="wrap">
      <div class="story-head reveal">
        <p class="chapter-no"><span>01</span> Read</p>
        <h2 class="h-story">The whole Granth, set to be read</h2>
        <p class="body-lg">All {ANGS} Angs in Sant Lipi, on warm paper or in a night scheme that is never pure black. Turn pages, jump to any Ang, pick up where you left off. Every composition opens with its printed heading, and transliteration can sit quietly under each line. Sehaj focus leaves only the Gurmukhi, with room to breathe.</p>
      </div>
      <div class="reader-wide reveal" data-delay="1">
        <DeviceFrame kind="ipad" frame={false} src={ipadReader} sizes="(min-width: 1240px) 1160px, 94vw"
          alt="Reader on iPad in landscape, open at Ang 705 — Gurmukhi in Sant Lipi with transliteration under each line" />
      </div>
    </div>
  </section>

  <!-- Saroop strip — before / after -->
  <section class="sec surface-warm" id="saroop" data-chapter="saroop">
    <div class="wrap story-grid story-grid--6-6">
      <div class="story-text reveal">
        <p class="eyebrow">Traditional saroop</p>
        <h2 class="h-story">Two ways to draw the same characters</h2>
        <p class="body-lg">Traditional saroop draws the doubled subjoined ya as the single tucked form used in the printed Bir; turn it off to see the exact source characters. Only the drawing changes — stored text, search and Copy are always the verbatim characters.</p>
      </div>
      <div class="story-media reveal" data-delay="1">
        <div class="pair pair--shots">
          <DeviceFrame frame={false} src={saroopOff} label="Saroop off" alt="Reader on iPhone at Ang 1400 with traditional saroop off" />
          <DeviceFrame frame={false} src={saroopOn} label="Saroop on (default)" alt="Reader on iPhone at Ang 1400 with traditional saroop on" />
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · SEARCH -->
  <section class="sec surface-paper" id="search" data-chapter="search">
    <div class="wrap story-grid">
      <div class="story-text reveal">
        <p class="chapter-no"><span>02</span> Search</p>
        <h2 class="h-story">Search the way you remember</h2>
        <p class="body-lg">A word in Gurmukhi, a word as it sounds in Roman letters, or just the first letters of each word — the way a line comes back to you. Auto mode works out which you meant.</p>
        <p class="body-lg">Verify checks a line you were sent against the text and tells you plainly whether it is there, and where.</p>
        <ul class="factrail detail-row">
          <li>Auto</li><li>Gurmukhi</li><li>Roman</li><li>First letters</li><li>Theme</li><li>Verify</li>
        </ul>
      </div>
      <div class="story-media reveal" data-delay="1">
        <div class="pair">
          <DeviceFrame src={searchRoman} alt="Search on iPhone: the Roman word naam, in Auto mode, finds matching lines with their Ang and voice" />
          <DeviceFrame src={verifyShot} alt="Verify on iPhone: a line typed in Roman letters, confirmed as scripture and shown as its canonical line, Ang 8" />
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · HUKAM -->
  <section class="sec surface-paper hair-top" id="hukam" data-chapter="hukam">
    <div class="wrap story-grid story-grid--6-6 story--flip">
      <div class="story-text reveal">
        <p class="chapter-no"><span>03</span> Hukam</p>
        <h2 class="h-story">The Hukam of the day, or a fresh one</h2>
        <p class="body-lg">The Hukam of the day is one complete Hukam for the whole day, chosen by the date — the same in the app and when you ask Siri, and the Hukam of the day widget shows its opening verse with its Ang. When you want another, draw a fresh one.</p>
        <p class="body-lg">Either way it is a complete unit — a whole shabad, or a Vaar's pauri with the saloks set before it — never a fragment, read verbatim and cited by its Ang. One tap takes you to that Ang in the Reader.</p>
        <p class="detail">The Hukam of the day is chosen on your device by the date. It is not the Hukamnama issued from Sri Harmandir Sahib.</p>
      </div>
      <div class="story-media reveal" data-delay="1">
        <div class="stage">
          <DeviceFrame src={hukamShot} alt="A Hukam open on iPhone: a complete shabad in Raag Kalyan, Ang 1319, with its Rahao line marked and a button to open the Ang in the Reader" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · NITNEM -->
  <section class="sec surface-warm" id="nitnem" data-chapter="nitnem">
    <div class="wrap story-grid">
      <div class="story-text reveal">
        <p class="chapter-no"><span>04</span> Nitnem</p>
        <h2 class="h-story">Nitnem, with your place kept</h2>
        <p class="body-lg">The daily banis by time of day — Japji, Jaap, Savaiye, Chaupai and Anand in the morning, Rehras at dusk, Sohila at night — with Sukhmani, Asa di Vaar and Ardaas alongside. The app remembers where you are in each.</p>
        <p class="body-lg">Short-line banis such as Jaap, Chaupai and Savaiye are set two half-lines to a row, as in a gutka. Rehras follows the SGPC Nitnem Gutka or the longer Damdami Taksal reading — your choice. Make your own sets, and a reading journey keeps a quiet record of the days you read. Reminders are optional, local, and yours to set.</p>
        <p class="detail">Banis from Sri Guru Granth Sahib Ji come from the same verified corpus, cited by Ang. Dasam Granth and Ardaas text are a separate, labelled, scholar-reviewed layer.</p>
      </div>
      <div class="story-media reveal" data-delay="1">
        <div class="stage stage--ipad">
          <DeviceFrame kind="ipad" src={ipadNitnem} alt="Nitnem on iPad in landscape: the morning banis with progress rings, and the full list by time of day" />
          <div class="overlap media-secondary">
            <DeviceFrame src={journeyShot} sizes="200px" alt="Nitnem reading journey on iPhone: the calendar where the days you read are kept" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · RAAG CLOCK (dark) -->
  <section class="sec surface-ink" id="raag-clock" data-theme="dark" data-chapter="raag-clock">
    <div class="wrap story-grid story--flip">
      <div class="story-text reveal">
        <p class="chapter-no"><span>05</span> The watch</p>
        <h2 class="h-story">Eight watches. {spell(FACTS.raags)} raags. One face.</h2>
        <p class="body-lg">The day is divided into eight pahars, and different raags belong to different watches. The Raag Clock shows which belong to this one — by fixed hours, or by your local sunrise and sunset, worked out on the device. The deep night is left in silence.</p>
        <p class="cta-row"><a class="btn ghost" href="/watch" data-astro-prefetch>More about the watch</a></p>
      </div>
      <div class="story-media reveal" data-delay="1">
        <div class="pair wash">
          <DeviceFrame src={clockDark} label="Fixed hours" alt="Raag Clock on iPhone, fixed hours: the 2nd pahar of day, 9 am to 12 pm" />
          <DeviceFrame src={clockSolar} label="Sunrise and sunset" alt="Raag Clock on iPhone, solar mode: the watch computed from local sunrise and sunset" />
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · VAARS -->
  <FeatureChapter id="vaars" no="06" label="Vaars" title="The Vaars, woven as printed" shots={vaarShots}
    figures={[
      { n: fmt(FACTS.vaars), l: "Vaars" },
      { n: fmt(FACTS.vaar_pauris), l: "pauris" },
      { n: fmt(FACTS.vaar_saloks), l: "saloks set beside them" },
    ]}
    figuresLabel="The Vaars, counted as the Granth prints them">
    <p class="body-lg">All {FACTS.vaars} Vaars, each with its voices: who wrote the pauris, and whose saloks are set beside them. The weave lays a Vaar out in reading order, pauri by pauri and salok by salok, as the Granth prints it.</p>
    <p class="body-lg">The reader carries you through a whole Vaar and keeps your place. Show the pauris only, and the saloks are hidden, never removed.</p>
    <p class="detail">Ask Siri to “Read a Vaar”, or reach the Vaars from a raag's page in the Index.</p>
  </FeatureChapter>

  <!-- 7 · INDEX -->
  <FeatureChapter id="index" no="07" label="Index" title="An Index that follows the saroop" surface="warm" flip shots={indexShots}
    figures={[
      { n: ANGS, l: "Angs, from the first to the last" },
      { n: fmt(FACTS.raags), l: "raags, each with its own page" },
    ]}
    figuresLabel="The Index in numbers">
    <p class="body-lg">The Index lays the Granth out in the order of the saroop: a ribbon from Ang 1 to Ang {ANGS}, the major compositions with your place kept, and all {FACTS.raags} raags. Every raag has its own page — where it sits in the Granth, the voices in it, the forms its headings name, and the time tradition gives it.</p>
    <p class="body-lg">“In this hour” gathers the raags of the current watch. Find in Index goes straight to a raag, a bani, a composition or a voice, and Forms lists the poetic forms the printed headings name.</p>
    <p class="detail">A raag's traditional time is tradition, not scripture — the app says so, and names the source of every claim.</p>
  </FeatureChapter>

  <!-- 8 · THEMES -->
  <FeatureChapter id="themes" no="08" label="Themes" title={`${FACTS.themes} themes, a page for each`} shots={themeShots}
    figures={[
      { n: fmt(FACTS.themes), l: "themes, each with its own page" },
      { n: fmt(FACTS.themed_lines), l: "lines of the Granth carry a theme's words" },
    ]}
    figuresLabel="Themes in numbers">
    <p class="body-lg">Themes traces ideas across the whole Granth by the words that carry them, with a theme of the day at the top. Every theme has its own page: the Rahao lines that carry it, where it lives by raag and by voice, the forms of its words, and the themes it often appears with — and a verse list you can narrow to a single word form.</p>
    <p class="body-lg">Your themes shows which themes your saved verses carry. It is worked out on your device, never sent anywhere, and you can turn it off.</p>
    <p class="detail">A theme's number counts the verses that carry its words — never a measure of importance. Themes are also in Spotlight, and Siri can “Open a theme”.</p>
  </FeatureChapter>

  <!-- 9 · VOICES -->
  <FeatureChapter id="voices" no="09" label="Voices" title={`${FACTS.voices} voices, one Granth`} surface="warm" flip shots={voiceShots}
    figures={[
      { n: fmt(FACTS.voices), l: "voices with Bani in the Granth" },
      { n: fmt(FACTS.voice_traditions), l: "traditions: Gurus, Bhagats, Bhatts and Gursikh companions" },
      { n: `${ordinal(FACTS.voices_first_century)}–${ordinal(FACTS.voices_last_century)}`, l: "centuries their dated lives span" },
    ]}
    figuresLabel="The voices of the Granth">
    <p class="body-lg">Lineage follows every voice whose Bani is in the Granth — the Gurus, the Bhagats, the court Bhatts and the Gursikh companions — from the {VOICE_CENTURIES}, as a roll or as a river through time, with a voice of the day. Every voice has a page: their Bani in the Granth and its raags, their notable Banis, how they sign their verses, who they name and who names them, their distinctive words, and the voices they echo. Compare sets two side by side.</p>
    <p class="body-lg">In Insights, the Granth becomes a field of dots, one for about 50 lines, coloured by tradition, and a ribbon shows where each voice sings.</p>
    <p class="detail">Who wrote each line follows the evidence printed in the Granth: a composition's heading, or the pen-name in its closing verse. Dates are approximate and cited; fuller notes on each life wait for scholarly review and are marked so.</p>
  </FeatureChapter>

  <!-- 10 · WIDGETS, SIRI AND SPOTLIGHT -->
  <section class="sec surface-paper" id="widgets" data-chapter="widgets">
    <div class="wrap story-grid story-grid--4-8">
      <div class="story-text reveal">
        <p class="chapter-no"><span>10</span> At a glance</p>
        <h2 class="h-story">On your Home Screen, Lock Screen and in Siri</h2>
        <p class="body-lg">Three widgets: the raag of the moment, the Hukam of the day with its Ang, and today's Nitnem — in sizes from small to large, with Lock Screen accessories for the raag and the Nitnem. An optional Live Activity shows how far you have read a bani. It never shows a verse.</p>
        <p class="detail">Siri: “Today’s Hukam”, “Draw a Hukam”, “What raag is it now”, “Read a bani”, “Read a Vaar”, “Search Gurbani”, “Show the constellation”, “Open a theme”, “Open a voice”. Shortcuts: “Open Ang”. Spotlight finds your saved verses and all {FACTS.themes} themes.</p>
      </div>
      <div class="story-media reveal" data-delay="1">
        <div class="widgets">
          <div class="wrow wrow--rev">
            <figure class="widget widget--m"><Image src={wHukamDark} widths={[500, 1000]} sizes="(min-width: 980px) 500px, 64vw" loading="lazy" decoding="async" alt="Hukam of the day widget, medium, in the dark scheme: an opening verse with its transliteration, cited Sri Guru Granth Sahib Ji, Ang 13" /></figure>
            <figure class="widget widget--s"><Image src={wRaag} widths={[240, 480]} sizes="(min-width: 980px) 230px, 30vw" loading="lazy" decoding="async" alt="Raag Now widget, small: the 24-hour dial at 4:40 pm, the 4th pahar of day" /></figure>
          </div>
          <div class="wrow">
            <figure class="widget widget--s"><Image src={wNitnemSmall} widths={[240, 480]} sizes="(min-width: 980px) 230px, 30vw" loading="lazy" decoding="async" alt="Nitnem widget, small: the morning banis, with Jaap Sahib next" /></figure>
            <figure class="widget widget--m"><Image src={wNitnemDark} widths={[500, 1000]} sizes="(min-width: 980px) 500px, 64vw" loading="lazy" decoding="async" alt="Nitnem widget, medium, in the dark scheme: the morning banis, with Jaap Sahib next and a progress ring" /></figure>
          </div>
          <figure class="la">
            <div class="la-card"><Image src={laCard} widths={[450, 900]} sizes="(min-width: 980px) 740px, 92vw" loading="lazy" decoding="async" alt="Live Activity on the Lock Screen: reading Japji Sahib, a progress ring at 1%" /></div>
            <figcaption>Live Activity on the Lock Screen — progress only, never a verse.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 11 · EXPLORE -->
  <FeatureChapter id="explore" no="11" label="Explore" title="Seven ways into the Granth" surface="warm" shots={exploreShots}>
    <p class="body-lg">Explore gathers them in one place: the Index, Themes, Lineage, Insights, Constellation, the Vaars and the Raag Clock. On iPad, all of it at once.</p>
    <p class="body-lg">Constellation shows which themes travel together in the same verses — matched by a shared word, not by meaning — with a focus on one theme, lenses by voice, raag and hour, and the Sky of all {FACTS.themes} themes. Insights counts and compares, described plainly.</p>
  </FeatureChapter>

  <!-- Photo band (dark scope) — between two light chapters, never beside Gurmukhi text -->
  <PhotoBand src={widePhoto} position="center 55%"
    alt="Sri Harmandir Sahib across the sarovar, the causeway and the marble parikrama">
    <p class="h-statement">Quiet enough to hear.</p>
    <p class="pb-sub">A place to read, and nothing else.</p>
  </PhotoBand>

  <!-- Display: the accent strip -->
  <section class="sec surface-warm" id="accents" data-chapter="accents">
    <div class="wrap">
      <div class="story-head reveal">
        <p class="eyebrow">Display</p>
        <h2 class="h-story">Five accents. Gold leads.</h2>
        <p class="body-lg">Soul gold by default, with saffron, gold, indigo and teal to choose from. Display also sets the Gurmukhi size, transliteration, appearance and traditional saroop. The Gurmukhi itself always stays in ink.</p>
      </div>
      <div class="accent-box reveal" data-delay="1" tabindex="0" role="region" aria-label="The five accents">
      <ul class="accent-strip">
        {accents.map((a) => (
          <li>
            <figure class="shot">
              <div class="shot-in"><Image src={a.src} widths={[240, 480]} sizes="(min-width: 980px) 220px, 44vw" loading="lazy" decoding="async" alt={`Reader on iPhone at Ang 1 with the ${a.name} accent`} /></div>
              <figcaption>{a.name}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      </div>
    </div>
  </section>

  <!-- 12 · CLOSING (dark) -->
  <section class="sec surface-ink closing" id="verbatim" data-theme="dark" data-chapter="verbatim">
    <div class="wrap closing-in reveal">
      <span class="gold-hair" aria-hidden="true"></span>
      <h2 class="h-statement">Nothing corrected. Nothing invented.</h2>
      <p class="body-lg">The text is reproduced character for character from the source edition and checked against a SHA-256 checksum when the app is installed or updated. Nothing is normalised, modernised or improved. Never AI-generated.</p>
      <div class="cta-row">
        <a class="btn" href="/privacy">Read the privacy policy</a>
        <a class="btn ghost" href="/support">Get support</a>
      </div>
    </div>
  </section>

  <ContributeBand surface="paper" />

  <MarketingFooter />

  <style>
    [data-chapter] { scroll-margin-top: 72px; }
    .page-hero { padding: clamp(96px, 12vw, 150px) 0 clamp(16px, 3vw, 32px); }
