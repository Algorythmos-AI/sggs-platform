---
import Base from '../layouts/Base.astro';
---
<Base title="ੴ Sri Guru Granth Sahib Ji — Reader">
  <section id="v-ang">
    <!-- the Reader's own bar, as in the app: where you are (tap it to go somewhere else) and how it reads -->
    <div class="toolbar">
      <button id="jumpBtn" class="tb-btn" type="button" aria-haspopup="dialog" aria-controls="jumpSheet">Go to</button>
      <button id="angTitle" class="tb-title" type="button" aria-haspopup="dialog" aria-controls="jumpSheet"
              aria-label="Ang 1 of 1430. Go to another Ang"><span id="angTitleN">Ang 1</span><span class="tb-caret" aria-hidden="true">⌄</span></button>
      <button id="readerOptsBtn" class="tb-btn tb-aa" type="button" aria-haspopup="dialog" aria-expanded="false"
              aria-controls="readerOpts" aria-label="Reading options">ਅA</button>
    </div>
    <div id="raagBanner"></div>
    <div class="ctx" id="angCtx"></div>
    <div id="angOut"></div>
    <button id="sehajExit" class="sehaj-exit" type="button" onclick="sehaj()">Exit Sehaj</button>
  </section>

  <!-- the page bar, in the thumb's reach: where this Ang is in the Granth, and the Angs either side -->
  <nav id="pageBar" class="pagebar" aria-label="Ang by Ang">
    <button id="pageProgress" class="pb-progress" type="button" aria-haspopup="dialog" aria-controls="jumpSheet">
      <span id="pageProgressT">Ang 1 of 1430</span>
      <span class="pb-track" aria-hidden="true"><i id="pageProgressBar"></i></span>
    </button>
    <div class="pb-row">
      <button id="prevAng" class="pb-side" type="button" aria-label="Previous Ang"><span aria-hidden="true">‹</span><b id="prevAngN"></b></button>
      <button class="pb-hukam" type="button" data-random><span aria-hidden="true">✦</span> Hukam</button>
      <button id="nextAng" class="pb-side" type="button" aria-label="Next Ang"><b id="nextAngN"></b><span aria-hidden="true">›</span></button>
    </div>
  </nav>

  <!-- reading options: the size first, then what is shown -->
  <div id="readerOptsScrim" class="ro-scrim" aria-hidden="true"></div>
  <div id="readerOpts" class="ro" role="dialog" aria-modal="true" aria-label="Reading options" inert>
    <div class="ro-size">
      <button type="button" class="ro-step" onclick="fontSize(-1)" aria-label="Smaller text">ਅ−</button>
      <span class="ro-sample gm" lang="pa" aria-hidden="true">ੳ ਅ ੲ</span>
      <button type="button" class="ro-step" onclick="fontSize(1)" aria-label="Larger text">ਅ+</button>
    </div>
    <div class="tgl" id="tglT" onclick="toggleT()" role="switch" tabindex="0" aria-checked="true"
         aria-label="show transliteration" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleT()}">
      <span>Transliteration</span><span class="sw"></span></div>
    <div class="tgl" id="tglTime" onclick="toggleTiming()" role="switch" tabindex="0" aria-checked="true"
         aria-label="show raag timing chip (scholarly metadata near the raag heading — never changes the scripture)"
         onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleTiming()}">
      <span>Timing chip</span><span class="sw"></span></div>
    <button id="sehajBtn" class="ro-sehaj" onclick="sehaj()" title="Sehaj — calm focus reading (Esc to exit)" aria-label="Focus reading mode" aria-pressed="false">✦ Sehaj focus</button>
  </div>

  <!-- go to an Ang: type it, drag to it, step to it, or pick a raag -->
  <div id="jumpScrim" class="jump-scrim" aria-hidden="true"></div>
  <div id="jumpSheet" class="jump" role="dialog" aria-modal="true" aria-labelledby="jumpTitle" inert>
    <div class="jump-head">
      <h2 id="jumpTitle">Go to Ang</h2>
      <button id="jumpClose" class="jump-x" type="button" aria-label="Close">×</button>
    </div>
    <form id="jumpForm" novalidate>
      <div class="jump-num">
        <label for="angIn">Ang</label>
        <input id="angIn" type="number" inputmode="numeric" min="1" max="1430" value="1" aria-describedby="jumpWhere jumpErr" />
        <span class="jump-of">of 1430</span>
      </div>
      <p id="jumpErr" class="jump-err" role="alert" hidden>Enter an Ang between 1 and 1430.</p>
      <p id="jumpWhere" class="jump-where" aria-live="polite"></p>
      <div class="jump-scrub">
        <button type="button" class="jump-step" data-jump-step="-1" aria-label="One Ang back">−</button>
        <div class="jump-track">
          <div id="jumpTicks" class="jump-ticks" aria-hidden="true"></div>
          <input id="jumpRange" type="range" min="1" max="1430" step="1" value="1" aria-label="Ang, across the whole Granth" />
        </div>
        <button type="button" class="jump-step" data-jump-step="1" aria-label="One Ang on">+</button>
      </div>
      <label class="jump-raag">Jump to a raag
        <select id="jumpRaag"><option value="">Choose…</option></select>
      </label>
      <button id="jumpGo" class="jump-go" type="submit">Go to Ang 1</button>
    </form>
  </div>
  <script>import '../scripts/reader';</script>
</Base>
